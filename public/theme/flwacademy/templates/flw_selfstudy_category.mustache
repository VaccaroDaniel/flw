{{!
    @template theme_flwacademy/flw_selfstudy_category

    FLW Self Study category page.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block flw-selfstudy-wrapper">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}
    {{> theme_flwacademy/flw_tools_group }}

    <style>
        .flw-school-category-page{margin:0;background:var(--flw-bg);color:var(--flw-ink);font-family:Inter,"Segoe UI",Arial,sans-serif;line-height:1.5}
        .flw-page-shell{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:86px 0 56px}.flw-stack{display:grid;gap:22px}
        .flw-band,.flw-card{border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface);box-shadow:var(--flw-shadow);color:var(--flw-ink)!important}.flw-band-inner{padding:24px}
        .flw-sub-banner{position:relative;min-height:340px;display:grid;align-items:center;overflow:hidden;padding:32px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;box-shadow:var(--flw-shadow)}.flw-sub-banner:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(255,255,255,.70),rgba(255,255,255,.06))}.flw-sub-banner img{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center 58%}.flw-sub-banner>div{position:relative;z-index:2;max-width:860px}
        .flw-page-kicker{margin:0 0 8px;color:var(--flw-teal-dark)!important;font-size:13px;font-weight:800;text-transform:uppercase}.flw-sub-banner h1{margin:0 0 10px;color:#101a3a;font-size:42px;line-height:1.05;font-weight:700;text-shadow:0 2px 12px rgba(255,255,255,.58)}.flw-sub-banner p:not(.flw-page-kicker){max-width:780px;margin:10px 0 0;color:#405477;font-size:15px;line-height:1.35;text-shadow:0 2px 10px rgba(255,255,255,.62)}
        .flw-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:14px}.flw-section-heading h2,.flw-card h2{margin:0 0 10px;color:var(--flw-ink);font-size:26px;line-height:1.18;font-weight:700}.flw-card h3{margin:0 0 8px;color:var(--flw-ink);font-size:18px;line-height:1.25;font-weight:700}.flw-muted{color:var(--flw-muted)!important}
        .flw-card{min-width:0;padding:18px;color:var(--flw-ink)!important}.flw-card p:not(.flw-muted):not(.flw-page-kicker),.flw-card li,.flw-card small,.flw-band p:not(.flw-muted):not(.flw-page-kicker),.flw-band li{color:var(--flw-ink)!important}.flw-card.accent-teal{border-top:5px solid var(--flw-teal)}.flw-card.accent-coral{border-top:5px solid var(--flw-coral)}.flw-card.accent-green{border-top:5px solid var(--flw-green)}.flw-card.accent-yellow{border-top:5px solid var(--flw-yellow)}.flw-card.accent-blue{border-top:5px solid var(--flw-blue)}
        .flw-top-grid{display:grid;grid-template-columns:minmax(250px,.38fr) minmax(0,.62fr);gap:12px}.flw-panel-card{display:grid;gap:10px;align-content:start;min-height:0;padding:14px}.flw-top-grid .flw-page-kicker{margin-bottom:5px;font-size:11px}.flw-top-grid h2{margin-bottom:6px!important;font-size:21px!important}.flw-top-grid .flw-muted{margin:0;font-size:14px;line-height:1.38}.flw-placement-card{grid-template-rows:auto auto min-content}.flw-profile-card{gap:9px}
        .flw-metric-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:8px}.flw-top-grid .flw-metric-strip{margin-top:0}.flw-metric{min-height:64px;padding:10px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.86)}.flw-metric strong{display:block;color:var(--flw-teal-dark);font-size:20px;line-height:1}.flw-metric span{color:var(--flw-muted);font-size:12px}
        .flw-profile-status{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.flw-profile-pill{padding:8px 9px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface-strong)}.flw-profile-pill span{display:block;color:var(--flw-muted);font-size:11px}.flw-profile-pill strong{display:block;color:var(--flw-ink);font-size:13px;line-height:1.2}.flw-checkpoint-button{width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;margin-top:6px;padding:0;border:1px solid rgba(10,75,232,.22);border-radius:50%;background:#fff;color:var(--flw-teal)!important;text-decoration:none!important;box-shadow:0 5px 14px rgba(10,75,232,.16);transition:transform .14s ease,border-color .14s ease,box-shadow .14s ease}.flw-checkpoint-button:before{content:"";display:block;width:0;height:0;margin-left:2px;border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:9px solid currentColor;animation:flw-triangle-pulse 1.25s ease-in-out infinite}.flw-checkpoint-button:hover,.flw-checkpoint-button:focus{border-color:var(--flw-teal);box-shadow:0 8px 18px rgba(10,75,232,.24);outline:0;transform:translateX(2px)}.flw-checkpoint-button:hover:before,.flw-checkpoint-button:focus:before{animation-duration:.75s}@keyframes flw-triangle-pulse{0%,100%{transform:translateX(0);opacity:.72}50%{transform:translateX(3px);opacity:1}}@media(prefers-reduced-motion:reduce){.flw-checkpoint-button:before{animation:none}}.flw-sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}.flw-skill-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.flw-skill-item{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:7px 8px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff}.flw-skill-item span{color:var(--flw-muted);font-size:12px}.flw-skill-item strong{color:var(--flw-teal-dark);font-size:12px}.flw-support-list{display:flex;flex-wrap:wrap;gap:5px;margin:0;padding:0;list-style:none}.flw-support-list li{padding:4px 7px;border-radius:999px;background:rgba(232,93,79,.1);color:#8f2d26!important;font-size:11px;font-weight:800}.flw-profile-actions{display:flex;flex-wrap:wrap;gap:7px;align-items:center}.flw-profile-updated{color:var(--flw-muted);font-size:12px}
        .flw-button{min-height:36px;display:inline-flex;align-items:center;justify-content:center;width:max-content;padding:7px 12px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;font-size:13px;font-weight:700;text-decoration:none!important}.flw-button.primary{border-color:var(--flw-teal);background:var(--flw-teal);color:#fff!important}
        .flw-language-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.flw-language-tile{min-height:168px;display:grid;grid-template-rows:96px auto auto;gap:5px;align-items:center;justify-items:center;padding:10px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;text-align:center;text-decoration:none!important}.flw-language-tile img{width:100%;height:96px;object-fit:cover;border-radius:calc(var(--flw-radius) - 4px)}.flw-language-tile span{font-weight:900}.flw-language-tile small{color:var(--flw-muted);font-size:12px}.flw-language-tile.active{border-color:var(--flw-teal);box-shadow:0 0 0 3px rgba(10,75,232,.12)}
        .flw-selected-course{margin-top:18px}.flw-map-preview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.flw-map-node{display:grid;gap:7px;min-height:138px;padding:14px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:linear-gradient(135deg,rgba(10,75,232,.08),rgba(255,255,255,0) 58%),#fff;color:var(--flw-ink)!important;text-decoration:none!important}.flw-map-node span{color:var(--flw-coral);font-size:12px;font-weight:950;text-transform:uppercase}.flw-map-node strong{font-size:18px}.flw-map-node small{color:var(--flw-muted);line-height:1.45}
        .flw-reference-grid,.flw-course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.flw-course-card{display:grid;gap:10px;align-content:start;overflow:hidden;padding:10px;text-decoration:none!important}.flw-course-cover{width:100%;aspect-ratio:16/9;display:block;border-radius:calc(var(--flw-radius) - 2px);object-fit:cover;background:var(--flw-surface-strong)}.flw-course-meta{color:var(--flw-teal-dark)!important;font-size:12px;font-weight:800;text-transform:uppercase}.flw-course-card h3{margin-bottom:0}.flw-empty{padding:18px;border:1px dashed var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.7);color:var(--flw-muted)}.flw-hidden-maincontent{display:none!important}.flw-back-link{display:inline-flex;color:var(--flw-teal-dark)!important;font-weight:700;text-decoration:none!important}
        .flw-school-category-page{background:#eef0f3;color:#111936;font-family:Arial,Helvetica,sans-serif;line-height:1.35}
        .flw-page-shell{width:min(1428px,calc(100% - 20px));padding:84px 0 56px}
        .flw-band,.flw-card{border-color:#e5e8ef;border-radius:12px;background:#fff;box-shadow:0 4px 14px rgba(23,39,79,.10)}
        .flw-sub-banner{border-color:#e5e8ef;border-radius:12px;box-shadow:0 4px 14px rgba(23,39,79,.10)}
        .flw-page-kicker{color:#082a84!important;font-size:13px;font-weight:700}
        .flw-sub-banner h1,.flw-section-heading h2,.flw-card h2{font-family:Georgia,"Times New Roman",serif;color:#101a3a;font-weight:700}
        .flw-sub-banner h1{font-size:42px;line-height:1.08;letter-spacing:-1.4px}
        .flw-section-heading h2,.flw-card h2{font-size:26px;line-height:1.15}
        .flw-card h3,.flw-map-node strong,.flw-language-tile span{color:#10162b;font-size:18px;font-weight:700}
        .flw-sub-banner p:not(.flw-page-kicker){margin:10px 0 0;color:#405477!important;font-size:15px;line-height:1.35}.flw-muted,.flw-card p,.flw-band p,.flw-language-tile small,.flw-map-node small{color:#5f6d8d!important;font-size:13px;line-height:1.35}
        .flw-button{border-radius:7px;font-size:14px;font-weight:700}.flw-button.primary{border-color:#0a4be8;background:#0a4be8;color:#fff!important}.flw-button:not(.primary){border-color:#6f93ee;color:#0a4be8!important}
        .flw-card.accent-teal,.flw-course-card{border-top-color:#0a4be8}.flw-card.accent-blue{border-top-color:#327be1}.flw-card.accent-coral{border-top-color:#e85d4f}.flw-card.accent-green{border-top-color:#327be1}.flw-card.accent-yellow{border-top-color:#f38a00}
        @media(max-width:980px){.flw-top-grid,.flw-language-grid,.flw-map-preview,.flw-reference-grid,.flw-course-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.flw-profile-status,.flw-skill-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
        @media(max-width:640px){.flw-page-shell{width:min(100% - 22px,1180px);padding-top:76px}.flw-sub-banner,.flw-band-inner{padding:18px}.flw-top-grid,.flw-language-grid,.flw-map-preview,.flw-reference-grid,.flw-course-grid,.flw-metric-strip,.flw-profile-status,.flw-skill-list{grid-template-columns:1fr}}
    </style>

    <main id="page" class="flw-page-shell flw-stack">
        <section class="flw-sub-banner">
            <img src="{{heroimageurl}}" alt="" decoding="async" fetchpriority="high">
            <div>
                <p class="flw-page-kicker">{{#str}}doyouknow, theme_flwacademy{{/str}}</p>
                <h1>{{#str}}chooselanguagebegin, theme_flwacademy{{/str}}</h1>
                {{#hasdescription}}{{{description}}}{{/hasdescription}}
                {{^hasdescription}}<p>{{#str}}selfstudycategoryintro, theme_flwacademy{{/str}}</p>{{/hasdescription}}
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner flw-top-grid">
                <article class="flw-card accent-teal flw-panel-card flw-placement-card">
                    <div>
                        <p class="flw-page-kicker">{{#str}}placementtest, theme_flwacademy{{/str}}</p>
                        <h2>{{#str}}findstartingpoint, theme_flwacademy{{/str}}</h2>
                        <p class="flw-muted">{{#str}}placementtestintro, theme_flwacademy{{/str}}</p>
                    </div>
                    <div class="flw-metric-strip">
                        <div class="flw-metric"><strong>840</strong><span>{{#str}}items, theme_flwacademy{{/str}}</span></div>
                        <div class="flw-metric"><strong>7</strong><span>{{#str}}skills, theme_flwacademy{{/str}}</span></div>
                        <div class="flw-metric"><strong>A1</strong><span>{{#str}}currentlevel, theme_flwacademy{{/str}}</span></div>
                    </div>
                    <a class="flw-button primary" href="{{placementtesturl}}" data-flw-placement-link>{{#str}}takeplacementtestlower, theme_flwacademy{{/str}}</a>
                </article>
                <article class="flw-card accent-yellow flw-panel-card flw-profile-card">
                    {{#hasplacementprofile}}
                    {{#placementprofile}}
                    <div>
                        <p class="flw-page-kicker">{{#str}}userprofile, theme_flwacademy{{/str}}</p>
                        <h2>{{language}} {{#str}}placementresult, theme_flwacademy{{/str}}</h2>
                        <p class="flw-muted">{{studyrecommendation}}</p>
                    </div>
                    <div class="flw-metric-strip">
                        <div class="flw-metric"><strong>{{overallcefr}}</strong><span>{{#str}}placement, theme_flwacademy{{/str}}</span></div>
                        <div class="flw-metric"><strong>{{recommendedstartunit}}</strong><span>{{#str}}startunit, theme_flwacademy{{/str}}</span>{{#hasstartuniturl}}<a class="flw-checkpoint-button" href="{{startuniturl}}" title="{{startunitbuttonlabel}}" aria-label="{{startunitbuttonlabel}}"><span class="flw-sr-only">{{startunitbuttonlabel}}</span></a>{{/hasstartuniturl}}</div>
                        <div class="flw-metric"><strong>{{confidencepercent}}</strong><span>{{#str}}confidence, theme_flwacademy{{/str}}</span></div>
                    </div>
                    <div class="flw-profile-status">
                        <div class="flw-profile-pill"><span>{{#str}}status, theme_flwacademy{{/str}}</span><strong>{{placementstatus}}</strong></div>
                        <div class="flw-profile-pill"><span>{{#str}}pathmode, theme_flwacademy{{/str}}</span><strong>{{pathmode}}</strong></div>
                        <div class="flw-profile-pill"><span>{{#str}}nextcheckpoint, theme_flwacademy{{/str}}</span><strong>{{#str}}unit, theme_flwacademy{{/str}} {{nextcheckpointunit}}</strong>{{#hascheckpointurl}}<a class="flw-checkpoint-button" href="{{checkpointurl}}" title="{{checkpointbuttonlabel}}" aria-label="{{checkpointbuttonlabel}}"><span class="flw-sr-only">{{checkpointbuttonlabel}}</span></a>{{/hascheckpointurl}}</div>
                        <div class="flw-profile-pill"><span>{{#str}}updated, theme_flwacademy{{/str}}</span><strong>{{updatedlabel}}</strong></div>
                    </div>
                    {{#hasskillitems}}
                    <div class="flw-skill-list">
                        {{#skillitems}}
                        <div class="flw-skill-item"><span>{{label}}</span><strong>{{level}}{{#hasscore}} · {{score}}{{/hasscore}}</strong></div>
                        {{/skillitems}}
                    </div>
                    {{/hasskillitems}}
                    {{#hassupportitems}}
                    <ul class="flw-support-list">
                        {{#supportitems}}<li>{{label}} {{#str}}repair, theme_flwacademy{{/str}}</li>{{/supportitems}}
                    </ul>
                    {{/hassupportitems}}
                    {{#teacherreview}}<p class="flw-muted">{{#str}}teacherreviewrecommended, theme_flwacademy{{/str}}</p>{{/teacherreview}}
                    <div class="flw-profile-actions">
                        <a class="flw-button" href="{{reporturl}}">{{#str}}openreport, theme_flwacademy{{/str}}</a>
                        <a class="flw-button primary" href="{{placementtesturl}}" data-flw-placement-link>{{#str}}retakeplacementtest, theme_flwacademy{{/str}}</a>
                    </div>
                    {{/placementprofile}}
                    {{/hasplacementprofile}}
                    {{^hasplacementprofile}}
                    <div>
                        <p class="flw-page-kicker">{{#str}}userprofile, theme_flwacademy{{/str}}</p>
                        <h2>{{#str}}no, theme_flwacademy{{/str}} {{language}} {{#str}}placementyet, theme_flwacademy{{/str}}</h2>
                        <p class="flw-muted">{{#str}}completeplacementtest, theme_flwacademy{{/str}}</p>
                    </div>
                    <div class="flw-metric-strip">
                        <div class="flw-metric"><strong>-</strong><span>{{#str}}placement, theme_flwacademy{{/str}}</span></div>
                        <div class="flw-metric"><strong>-</strong><span>{{#str}}startunit, theme_flwacademy{{/str}}</span></div>
                        <div class="flw-metric"><strong>-</strong><span>{{#str}}confidence, theme_flwacademy{{/str}}</span></div>
                    </div>
                    <a class="flw-button primary" href="{{placementtesturl}}" data-flw-placement-link>{{#str}}takeplacementtestlower, theme_flwacademy{{/str}}</a>
                    {{/hasplacementprofile}}
                </article>
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading"><div><p class="flw-page-kicker">{{#str}}courses, theme_flwacademy{{/str}}</p><h2>{{language}} {{#str}}selfstudycourses, theme_flwacademy{{/str}}</h2></div></div>
                {{#hascourses}}
                <div class="flw-course-grid">
                    {{#courses}}
                    <a class="flw-card flw-course-card accent-teal" href="{{url}}">
                        <img class="flw-course-cover" src="{{imageurl}}" alt="" loading="lazy" decoding="async">
                        <span class="flw-course-meta">{{categoryname}}</span>
                        <h3>{{name}}</h3>
                    </a>
                    {{/courses}}
                </div>
                {{/hascourses}}
                {{^hascourses}}<div class="flw-empty">{{#str}}no, theme_flwacademy{{/str}} {{language}} {{#str}}selfstudycoursesadded, theme_flwacademy{{/str}}</div>{{/hascourses}}
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading">
                    <div>
                        <p class="flw-page-kicker">{{#str}}languagereferences, theme_flwacademy{{/str}}</p>
                        <h2>{{#str}}popularbooks, theme_flwacademy{{/str}}</h2>
                    </div>
                </div>
                <div class="flw-reference-grid">
                    <article class="flw-card accent-blue"><h3>{{#str}}coursebooks, theme_flwacademy{{/str}}</h3><p class="flw-muted">{{#str}}coursebookstext, theme_flwacademy{{/str}}</p></article>
                    <article class="flw-card accent-coral"><h3>{{#str}}grammar, theme_flwacademy{{/str}}</h3><p class="flw-muted">{{#str}}grammartext, theme_flwacademy{{/str}}</p></article>
                    <article class="flw-card accent-green"><h3>{{#str}}vocabulary, theme_flwacademy{{/str}}</h3><p class="flw-muted">{{#str}}vocabularytext, theme_flwacademy{{/str}}</p></article>
                </div>
            </div>
        </section>

        <div class="flw-hidden-maincontent">{{{maincontent}}}</div>
    </main>
</div>
{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
