{{!
    @template theme_flwacademy/flw_selfstudy_category

    FLW Self Study category page.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block flw-selfstudy-wrapper">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}
    {{> theme_flwacademy/flw_language_panel }}

    <style>
        :root{--flw-bg:#f7faf8;--flw-surface:#fff;--flw-surface-strong:#f7fbfa;--flw-ink:#17242a;--flw-muted:#5d6b72;--flw-line:#d8e3df;--flw-teal:#087f8c;--flw-teal-dark:#075a64;--flw-coral:#e85d4f;--flw-green:#4f9d54;--flw-yellow:#f2b84b;--flw-blue:#3278bd;--flw-radius:8px;--flw-shadow:0 12px 30px rgba(23,36,42,.09)}
        .flw-school-category-page{margin:0;background:var(--flw-bg);color:var(--flw-ink);font-family:Inter,"Segoe UI",Arial,sans-serif;line-height:1.5}
        .flw-page-shell{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:86px 0 56px}.flw-stack{display:grid;gap:22px}
        .flw-band,.flw-card{border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface);box-shadow:var(--flw-shadow);color:var(--flw-ink)!important}.flw-band-inner{padding:24px}
        .flw-sub-banner{position:relative;min-height:340px;display:grid;align-items:center;overflow:hidden;padding:32px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;box-shadow:var(--flw-shadow)}.flw-sub-banner:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(255,255,255,.86),rgba(255,255,255,.18))}.flw-sub-banner img{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center 58%}.flw-sub-banner>div{position:relative;z-index:2;max-width:860px}
        .flw-page-kicker{margin:0 0 8px;color:var(--flw-teal-dark)!important;font-size:13px;font-weight:800;text-transform:uppercase}.flw-sub-banner h1{margin:0 0 10px;color:#173f4f;font-size:clamp(34px,4.2vw,58px);line-height:1.05;font-weight:700;text-shadow:0 2px 12px rgba(255,255,255,.58)}.flw-sub-banner p:not(.flw-page-kicker){max-width:780px;margin:0;color:#233f46;font-size:19px;line-height:1.5;text-shadow:0 2px 10px rgba(255,255,255,.62)}
        .flw-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:14px}.flw-section-heading h2,.flw-card h2{margin:0 0 10px;color:var(--flw-ink);font-size:26px;line-height:1.18;font-weight:700}.flw-card h3{margin:0 0 8px;color:var(--flw-ink);font-size:18px;line-height:1.25;font-weight:700}.flw-muted{color:var(--flw-muted)!important}
        .flw-card{min-width:0;padding:18px;color:var(--flw-ink)!important}.flw-card p:not(.flw-muted):not(.flw-page-kicker),.flw-card li,.flw-card small,.flw-band p:not(.flw-muted):not(.flw-page-kicker),.flw-band li{color:var(--flw-ink)!important}.flw-card.accent-teal{border-top:5px solid var(--flw-teal)}.flw-card.accent-coral{border-top:5px solid var(--flw-coral)}.flw-card.accent-green{border-top:5px solid var(--flw-green)}.flw-card.accent-yellow{border-top:5px solid var(--flw-yellow)}.flw-card.accent-blue{border-top:5px solid var(--flw-blue)}
        .flw-top-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.flw-panel-card{display:grid;gap:14px;align-content:space-between;min-height:285px}
        .flw-metric-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.flw-metric{min-height:82px;padding:14px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.86)}.flw-metric strong{display:block;color:var(--flw-teal-dark);font-size:22px;line-height:1}.flw-metric span{color:var(--flw-muted);font-size:13px}
        .flw-button{min-height:42px;display:inline-flex;align-items:center;justify-content:center;width:max-content;padding:9px 14px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;font-weight:700;text-decoration:none!important}.flw-button.primary{border-color:var(--flw-teal);background:var(--flw-teal);color:#fff!important}
        .flw-language-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.flw-language-tile{min-height:168px;display:grid;grid-template-rows:96px auto auto;gap:5px;align-items:center;justify-items:center;padding:10px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;text-align:center;text-decoration:none!important}.flw-language-tile img{width:100%;height:96px;object-fit:cover;border-radius:calc(var(--flw-radius) - 4px)}.flw-language-tile span{font-weight:900}.flw-language-tile small{color:var(--flw-muted);font-size:12px}.flw-language-tile.active{border-color:var(--flw-teal);box-shadow:0 0 0 3px rgba(8,127,140,.12)}
        .flw-selected-course{margin-top:18px}.flw-map-preview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.flw-map-node{display:grid;gap:7px;min-height:138px;padding:14px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:linear-gradient(135deg,rgba(8,127,140,.08),rgba(255,255,255,0) 58%),#fff;color:var(--flw-ink)!important;text-decoration:none!important}.flw-map-node span{color:var(--flw-coral);font-size:12px;font-weight:950;text-transform:uppercase}.flw-map-node strong{font-size:18px}.flw-map-node small{color:var(--flw-muted);line-height:1.45}
        .flw-reference-grid,.flw-course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.flw-course-card{display:grid;gap:10px;align-content:start;overflow:hidden;padding:10px;text-decoration:none!important}.flw-course-cover{width:100%;aspect-ratio:16/9;display:block;border-radius:calc(var(--flw-radius) - 2px);object-fit:cover;background:var(--flw-surface-strong)}.flw-course-meta{color:var(--flw-teal-dark)!important;font-size:12px;font-weight:800;text-transform:uppercase}.flw-course-card h3{margin-bottom:0}.flw-empty{padding:18px;border:1px dashed var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.7);color:var(--flw-muted)}.flw-hidden-maincontent{display:none!important}.flw-back-link{display:inline-flex;color:var(--flw-teal-dark)!important;font-weight:700;text-decoration:none!important}
        @media(max-width:980px){.flw-top-grid,.flw-language-grid,.flw-map-preview,.flw-reference-grid,.flw-course-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
        @media(max-width:640px){.flw-page-shell{width:min(100% - 22px,1180px);padding-top:76px}.flw-sub-banner,.flw-band-inner{padding:18px}.flw-top-grid,.flw-language-grid,.flw-map-preview,.flw-reference-grid,.flw-course-grid,.flw-metric-strip{grid-template-columns:1fr}}
    </style>

    <main id="page" class="flw-page-shell flw-stack">
        <section class="flw-sub-banner">
            <img src="{{heroimageurl}}" alt="">
            <div>
                <p class="flw-page-kicker">Do you know?</p>
                <h1>Choose a language, then choose how to begin.</h1>
                {{#hasdescription}}{{{description}}}{{/hasdescription}}
                {{^hasdescription}}<p>Self Study joins the fixed full course and placement-based Learning Path. The content is the same; the entry point changes according to the learner.</p>{{/hasdescription}}
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner flw-top-grid">
                <article class="flw-card accent-teal flw-panel-card">
                    <div>
                        <p class="flw-page-kicker">Placement Test</p>
                        <h2>Find the right starting point.</h2>
                        <p class="flw-muted">Check grammar, vocabulary, reading, listening, speaking, writing, and pronunciation before choosing a learning route.</p>
                    </div>
                    <div class="flw-metric-strip">
                        <div class="flw-metric"><strong>840</strong><span>Items</span></div>
                        <div class="flw-metric"><strong>7</strong><span>Skills</span></div>
                        <div class="flw-metric"><strong>A1</strong><span>Current level</span></div>
                    </div>
                    <a class="flw-button primary" href="{{placementtesturl}}">Take placement test</a>
                </article>
                <article class="flw-card accent-yellow flw-panel-card">
                    <div>
                        <p class="flw-page-kicker">Learner Profile</p>
                        <h2>{{language}} learner</h2>
                        <p class="flw-muted">Your profile connects current level, practice history, quiz evidence, and the next recommended unit.</p>
                    </div>
                    <div class="flw-metric-strip">
                        <div class="flw-metric"><strong>0</strong><span>Activities</span></div>
                        <div class="flw-metric"><strong>0</strong><span>Hours</span></div>
                        <div class="flw-metric"><strong>0%</strong><span>Average</span></div>
                    </div>
                    <p class="flw-muted">Next: Unit 1 | Hello and first steps | Vocabulary.</p>
                </article>
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading"><div><p class="flw-page-kicker">Courses</p><h2>{{language}} Self Study Courses</h2></div></div>
                {{#hascourses}}
                <div class="flw-course-grid">
                    {{#courses}}
                    <a class="flw-card flw-course-card accent-teal" href="{{url}}">
                        <img class="flw-course-cover" src="{{imageurl}}" alt="">
                        <span class="flw-course-meta">{{categoryname}}</span>
                        <h3>{{name}}</h3>
                    </a>
                    {{/courses}}
                </div>
                {{/hascourses}}
                {{^hascourses}}<div class="flw-empty">No {{language}} self-study courses have been added yet.</div>{{/hascourses}}
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading">
                    <div>
                        <p class="flw-page-kicker">Language References</p>
                        <h2>Popular books to support full-course design and self-study.</h2>
                    </div>
                </div>
                <div class="flw-reference-grid">
                    <article class="flw-card accent-blue"><h3>Course books</h3><p class="flw-muted">Use a fixed full-course sequence as the main path.</p></article>
                    <article class="flw-card accent-coral"><h3>Grammar</h3><p class="flw-muted">Repair knowledge-point gaps with clear grammar references.</p></article>
                    <article class="flw-card accent-green"><h3>Vocabulary</h3><p class="flw-muted">Build words, phrases, examples, and review habits.</p></article>
                </div>
            </div>
        </section>

        <div class="flw-hidden-maincontent">{{{maincontent}}}</div>
    </main>
</div>
{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
