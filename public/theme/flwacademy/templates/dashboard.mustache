{{#js}}
(function() {
    try {
        var params = new URLSearchParams(window.location.search || '');
        var requestedLanguage = params.get('flwlang') || params.get('learninglanguage') || '';
        if (requestedLanguage) {
            window.localStorage.setItem('flw.learningLanguage', requestedLanguage);
            document.cookie = 'flw_learning_language=' + encodeURIComponent(requestedLanguage) + '; path=/; max-age=31536000; SameSite=Lax';
        }
    } catch (error) {
        // Language persistence is best-effort; server data already used the URL.
    }
    function bindPressEffect(root, selector) {
        root.querySelectorAll(selector).forEach(function(control) {
            control.addEventListener('pointerdown', function() {
                control.classList.add('is-pressing');
            });
            ['pointerup', 'pointercancel', 'mouseleave', 'blur'].forEach(function(eventname) {
                control.addEventListener(eventname, function() {
                    control.classList.remove('is-pressing');
                });
            });
        });
    }
    bindPressEffect(document, '.flw-dashboard-header button,.flw-dashboard-header a,.flw-sidebar-nav a,.flw-dropdown a,.flw-dropdown button,.flw-card-heading a,.flw-card-heading button,.flw-continue-actions a,.flw-continue-actions button,.flw-journey-panel>a,.flw-vocab-actions button,.flw-vocab-actions a,.flw-checkpoint-panel button,.flw-checkpoint-panel a');
    function setExpanded(button, expanded) {
        if (button) {
            button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        }
    }
    document.querySelectorAll('[data-flw-dropdown-toggle]').forEach(function(button) {
        button.addEventListener('click', function(event) {
            event.stopPropagation();
            var name = button.getAttribute('data-flw-dropdown-toggle');
            var menu = document.querySelector('[data-flw-dropdown="' + name + '"]');
            document.querySelectorAll('[data-flw-dropdown]').forEach(function(item) {
                if (item !== menu) {
                    item.classList.remove('open');
                }
            });
            var open = menu && !menu.classList.contains('open');
            if (menu) {
                menu.classList.toggle('open', open);
            }
            setExpanded(button, open);
        });
    });
    document.addEventListener('click', function() {
        document.querySelectorAll('[data-flw-dropdown]').forEach(function(menu) {
            menu.classList.remove('open');
        });
        document.querySelectorAll('[data-flw-dropdown-toggle]').forEach(function(button) {
            setExpanded(button, false);
        });
    });
    var sidebarButton = document.querySelector('[data-flw-sidebar-toggle]');
    var sidebar = document.querySelector('[data-flw-sidebar]');
    var scrim = document.querySelector('[data-flw-sidebar-scrim]');
    function closeSidebar() {
        if (!sidebar) {
            return;
        }
        sidebar.classList.remove('open');
        if (scrim) {
            scrim.classList.remove('open');
        }
        setExpanded(sidebarButton, false);
    }
    if (sidebarButton && sidebar) {
        sidebarButton.addEventListener('click', function(event) {
            event.stopPropagation();
            var open = !sidebar.classList.contains('open');
            sidebar.classList.toggle('open', open);
            if (scrim) {
                scrim.classList.toggle('open', open);
            }
            setExpanded(sidebarButton, open);
        });
        if (scrim) {
            scrim.addEventListener('click', closeSidebar);
        }
        sidebar.querySelectorAll('a[data-flw-nav-key]').forEach(function(link) {
            link.addEventListener('click', function() {
                closeSidebar();
            });
        });
    }
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeSidebar();
        }
    });
    var toast = document.querySelector('[data-flw-toast]');
    var timer;
    document.querySelectorAll('[data-flw-demo-message]').forEach(function(control) {
        control.addEventListener('click', function() {
            if (!toast) {
                return;
            }
            toast.textContent = control.getAttribute('data-flw-demo-message') || 'This action is ready to connect.';
            toast.classList.add('show');
            window.clearTimeout(timer);
            timer = window.setTimeout(function() {
                toast.classList.remove('show');
            }, 2400);
        });
    });
})();
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
