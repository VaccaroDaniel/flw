dth:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.flw-skill-icon.blue{background:#eef3ff;color:var(--flw-rd-blue)}.flw-skill-icon.green{background:#eef3ff;color:var(--flw-rd-green)}.flw-skill-icon.purple{background:#f1edff;color:var(--flw-rd-purple)}.flw-skill-icon.orange{background:#fff3e6;color:var(--flw-rd-orange)}.flw-skill-icon.cyan{background:#eef3ff;color:var(--flw-rd-cyan)}.flw-skill-row>strong{font-size:10px}.flw-skill-row>div{height:5px;background:#e8ebf0;border-radius:6px;overflow:hidden}.flw-skill-row>div i{display:block;height:100%;border-radius:6px}.flw-skill-row.listen>div i{background:var(--flw-rd-blue)}.flw-skill-row.speak>div i{background:var(--flw-rd-green)}.flw-skill-row.read>div i{background:var(--flw-rd-purple)}.flw-skill-row.write>div i{background:var(--flw-rd-orange)}.flw-skill-row.dictate>div i{background:var(--flw-rd-cyan)}.flw-skill-row>b{font-weight:400;color:#26334c}
        .flw-unit-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:10px 14px;margin-top:12px}.flw-unit-node{min-height:51px;grid-column:span 4;border:1px solid #e1e5eb;border-radius:10px;padding:8px 9px;position:relative;background:#fff;min-width:0;color:#18213a;text-decoration:none}.flw-unit-node:hover{border-color:#cbd8f5;box-shadow:0 6px 16px rgba(10,75,232,.08);color:#18213a;text-decoration:none}.flw-unit-node:after{content:"...";position:absolute;right:-17px;top:16px;color:#a8b8d7;font-size:10px}.flw-unit-node:nth-child(3n):after,.flw-unit-node:nth-child(6):after,.flw-unit-node:last-child:after{display:none}.flw-unit-node:nth-child(n+7){grid-column:span 3}.flw-unit-node:nth-child(7):after,.flw-unit-node:nth-child(8):after,.flw-unit-node:nth-child(9):after{display:block}.flw-unit-node strong{font-size:11px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}.flw-unit-node span{font-size:10px;color:#67748c;display:block;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.flw-unit-panel .flw-card-subtitle{font-size:12px}.flw-unit-node.complete span{color:var(--flw-rd-green)}.flw-unit-node.active{border-color:#6f94f3;box-shadow:0 0 0 1px #edf2ff}.flw-unit-node.active strong,.flw-unit-node.active span{color:var(--flw-rd-blue)}.flw-unit-node.locked{color:#68758a;background:#fafbfd}.flw-locked-label{display:flex!important;align-items:center;gap:3px}.flw-locked-label svg{width:10px;height:10px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}
