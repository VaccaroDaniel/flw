{{!
    @template theme_flwacademy/dashboard

    FLW Academy Moodle dashboard.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block flw-dashboard-wrapper">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}
    {{> theme_flwacademy/flw_language_panel }}

    <style>
        :root{--flw-font-body:Inter,"Segoe UI",Arial,sans-serif;--flw-bg:#f7faf8;--flw-surface:#fff;--flw-soft:#f0f6f4;--flw-ink:#17242a;--flw-muted:#5d6b72;--flw-line:#d8e3df;--flw-teal:#087f8c;--flw-teal-dark:#075a64;--flw-coral:#e85d4f;--flw-green:#4f9d54;--flw-yellow:#f2b84b;--flw-blue:#3278bd;--flw-radius:8px;--flw-shadow:0 12px 30px rgba(23,36,42,.09)}
        .flw-dashboard-page{margin:0;background:var(--flw-bg);color:var(--flw-ink);font-family:var(--flw-font-body);line-height:1.5;letter-spacing:0;color-scheme:light}
        .flw-dashboard-page a{text-decoration:none}
        .flw-dashboard{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:86px 0 56px;color:var(--flw-ink)!important}.flw-stack{display:grid;gap:22px}.flw-band,.flw-card{border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface);color:var(--flw-ink)!important;box-shadow:var(--flw-shadow)}.flw-band-inner{padding:24px}.flw-hero-banner{position:relative;min-height:430px;display:grid;align-items:center;overflow:hidden;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;box-shadow:var(--flw-shadow)}.flw-hero-banner:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(247,250,248,.96),rgba(247,250,248,.54),rgba(247,250,248,.1))}.flw-hero-art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.flw-hero-content{position:relative;z-index:2;max-width:780px;padding:34px}.flw-dashboard h1,.flw-dashboard h2,.flw-dashboard h3,.flw-dashboard p{margin-top:0}.flw-dashboard h1,.flw-dashboard h2,.flw-dashboard h3{color:var(--flw-ink)!important}.flw-dashboard p{color:var(--flw-ink)!important}.flw-dashboard h1{max-width:780px;margin-bottom:12px;font-size:42px;line-height:1.08;font-weight:700}.flw-dashboard h2{margin-bottom:10px;font-size:26px;line-height:1.18;font-weight:700}.flw-dashboard h3{margin-bottom:8px;font-size:18px;line-height:1.25;font-weight:700}.flw-lead{max-width:780px;color:var(--flw-muted)!important;font-size:18px}.flw-muted{color:var(--flw-muted)!important}.flw-page-kicker{margin:0 0 8px;color:var(--flw-teal-dark)!important;font-size:13px;font-weight:700;text-transform:uppercase}
        .flw-actions,.flw-action-row{display:flex;flex-wrap:wrap;gap:10px}.flw-button{min-height:42px;display:inline-flex;align-items:center;justify-content:center;padding:9px 14px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;font-weight:700}.flw-button.primary{border-color:var(--flw-teal);background:var(--flw-teal);color:#fff!important}.flw-button.ghost{background:rgba(255,255,255,.72)}.flw-button.small{min-height:34px;padding:7px 10px;font-size:14px}
        .flw-metric-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}.flw-metric{padding:14px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.86);color:var(--flw-ink)!important}.flw-metric strong{display:block;color:var(--flw-teal-dark)!important;font-size:26px;line-height:1;font-weight:700}.flw-metric span{color:var(--flw-muted)!important;font-size:13px;font-weight:650}
        .flw-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:14px}.flw-grid{display:grid;gap:14px}.flw-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.flw-grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.flw-split{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:24px;align-items:stretch}.flw-card{min-width:0;padding:18px}.flw-card.accent-teal{border-top:5px solid var(--flw-teal)}.flw-card.accent-coral{border-top:5px solid var(--flw-coral)}.flw-card.accent-green{border-top:5px solid var(--flw-green)}.flw-card.accent-yellow{border-top:5px solid var(--flw-yellow)}.flw-card.accent-blue{border-top:5px solid var(--flw-blue)}.flw-card-link{color:var(--flw-ink)!important}.flw-card-link:hover{transform:translateY(-2px)}
        .flw-progress-bar{height:10px;overflow:hidden;border-radius:999px;background:#dfe8e5}.flw-progress-fill{height:100%;width:var(--value,0%);border-radius:inherit;background:linear-gradient(90deg,var(--flw-teal),var(--flw-green))}.flw-skill-bars{display:grid;gap:12px}.flw-skill-line{display:grid;grid-template-columns:120px minmax(0,1fr) 44px;gap:10px;align-items:center}.flw-skill-line span{color:var(--flw-muted);font-size:13px}.flw-hidden-maincontent{display:none!important}
        @media(max-width:1100px){.flw-split,.flw-grid.four{grid-template-columns:1fr 1fr}}
        @media(max-width:720px){.flw-dashboard{width:min(100% - 22px,1180px);padding-top:76px}.flw-hero-content,.flw-band-inner{padding:18px}.flw-dashboard h1{font-size:32px}.flw-grid.three,.flw-grid.four,.flw-split,.flw-metric-strip{grid-template-columns:1fr}.flw-skill-line{grid-template-columns:1fr}.flw-app-usernav{width:100%;justify-content:space-between}}
    </style>

    <main id="page" data-region="mainpage" data-usertour="scroller" class="flw-dashboard">
        <div class="flw-stack">
            <section id="flw-school" class="flw-hero-banner">
                <img class="flw-hero-art" src="{{heroimageurl}}" alt="">
                <div class="flw-hero-content">
                    <h1>Find your level, choose a path, and know what to learn next.</h1>
                    <p class="flw-lead">FLW connects placement, course content, knowledge points, and progress so learners can answer three questions every day: where am I, what should I do next, and am I improving?</p>
                    <div class="flw-actions">
                        <a class="flw-button primary" href="{{defaultplacementtesturl}}" data-flw-placement-link>Start placement test</a>
                        <a class="flw-button" href="{{defaultselfstudyurl}}" data-flw-category-link="selfstudy">Continue course</a>
                        <a class="flw-button ghost" href="#flw-progress">View progress</a>
                    </div>
                    <div class="flw-metric-strip" aria-label="Dashboard summary">
                        <div class="flw-metric"><strong>7</strong><span>Languages planned</span></div>
                        <div class="flw-metric"><strong>72</strong><span>English units</span></div>
                        <div class="flw-metric"><strong>3</strong><span>Learning modes</span></div>
                        <div class="flw-metric"><strong>KP</strong><span>Goal-based path</span></div>
                    </div>
                </div>
            </section>

            <section id="flw-self-study" class="flw-band">
                <div class="flw-band-inner">
                    <div class="flw-section-heading">
                        <div>
                            <p class="flw-page-kicker">Self Study</p>
                            <h2>Choose a language, then choose how to begin.</h2>
                        </div>
                        <a class="flw-button small primary" href="{{defaultpracticeurl}}" data-flw-category-link="practice">Open Practice</a>
                    </div>
                    <div class="flw-grid four">
                        <a class="flw-card flw-card-link accent-teal" href="{{defaultselfstudyurl}}" data-flw-category-link="selfstudy"><p class="flw-page-kicker">Continue Learning</p><h3>Current path</h3><p class="flw-muted">Return to your visible path with placement, KP evidence, and progress checkpoints.</p></a>
                        <a class="flw-card flw-card-link accent-coral" href="{{defaultselfstudyurl}}" data-flw-category-link="selfstudy"><p class="flw-page-kicker">Choose Course</p><h3>Language library</h3><p class="flw-muted">Open the selected language course category.</p></a>
                        <a class="flw-card flw-card-link accent-green" href="{{defaultplacementtesturl}}" data-flw-placement-link><p class="flw-page-kicker">Placement Test</p><h3>Find my level</h3><p class="flw-muted">Use diagnostic tasks to locate your next useful language step.</p></a>
                        <a class="flw-card flw-card-link accent-yellow" href="{{defaultschoolurl}}" data-flw-category-link="school"><p class="flw-page-kicker">Course Map</p><h3>KP structure</h3><p class="flw-muted">See units, subskills, knowledge points, and expected evidence.</p></a>
                    </div>
                </div>
            </section>

            <section id="flw-practice" class="flw-band">
                <div class="flw-band-inner">
                    <div class="flw-section-heading">
                        <div>
                            <p class="flw-page-kicker">Practice</p>
                            <h2>Practice freely, then let the history support your profile.</h2>
                        </div>
                    </div>
                    <div class="flw-split">
                        <div class="flw-grid three">
                            <a class="flw-card flw-card-link accent-teal" href="{{defaultpracticewatchurl}}" data-flw-practice-submenu-link="watch"><p class="flw-page-kicker">Video</p><h3>Watch</h3><p class="flw-muted">Video practice by language and level: Easy, Medium, or Hard.</p></a>
                            <a class="flw-card flw-card-link accent-coral" href="{{defaultpracticelistenurl}}" data-flw-practice-submenu-link="listen"><p class="flw-page-kicker">Listening</p><h3>Listen</h3><p class="flw-muted">Audio and audio-plus-book materials by CEFR, HSK, JLPT, or TORFL level.</p></a>
                            <a class="flw-card flw-card-link accent-green" href="{{defaultpracticespeakurl}}" data-flw-practice-submenu-link="speak"><p class="flw-page-kicker">Speaking</p><h3>Speak</h3><p class="flw-muted">Choose a language, level, and topic for guided AI speaking practice.</p></a>
                        </div>
                        <article class="flw-card accent-yellow">
                            <p class="flw-page-kicker">Learner profile</p>
                            <h3>Practice activity</h3>
                            <div class="flw-metric-strip">
                                <div class="flw-metric"><strong>18</strong><span>Activities</span></div>
                                <div class="flw-metric"><strong>6.5</strong><span>Hours</span></div>
                                <div class="flw-metric"><strong>82%</strong><span>Average score</span></div>
                                <div class="flw-metric"><strong>B1</strong><span>Target</span></div>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <section id="flw-progress" class="flw-band">
                <div class="flw-band-inner flw-split">
                    <div>
                        <p class="flw-page-kicker">Today task</p>
                        <h2>Your next recommended mission</h2>
                        <p class="flw-lead">The current fast path is A2+ to B2 Speaking. Repair A2 listening and grammar gaps before B1 and B2 speaking missions.</p>
                        <div class="flw-action-row">
                            <a class="flw-button primary" href="{{defaultselfstudyurl}}" data-flw-category-link="selfstudy">Open KP Coach</a>
                            <a class="flw-button" href="{{defaultpracticeurl}}" data-flw-category-link="practice">Open lesson</a>
                        </div>
                    </div>
                    <div class="flw-card accent-coral">
                        <h3>A2 Travel Listening</h3>
                        <p class="flw-muted">Catch key details in short travel announcements. This is recommended before B1 interview listening.</p>
                        <div class="flw-skill-bars">
                            <div class="flw-skill-line"><span>Vocabulary</span><div class="flw-progress-bar"><div class="flw-progress-fill" style="--value:82%"></div></div><span>82%</span></div>
                            <div class="flw-skill-line"><span>Grammar</span><div class="flw-progress-bar"><div class="flw-progress-fill" style="--value:68%"></div></div><span>68%</span></div>
                            <div class="flw-skill-line"><span>Listening</span><div class="flw-progress-bar"><div class="flw-progress-fill" style="--value:54%"></div></div><span>54%</span></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="flw-grid four" aria-label="FLW tools">
                <article id="flw-dictionary" class="flw-card accent-blue"><p class="flw-page-kicker">Dictionary</p><h3>Learner dictionary</h3><p class="flw-muted">Search words across FLW languages, compare meanings, and connect vocabulary to knowledge points.</p></article>
                <a id="flw-exam" class="flw-card flw-card-link accent-coral" href="{{defaultexamurl}}" data-flw-category-link="exam"><p class="flw-page-kicker">Exam</p><h3>Exam practice</h3><p class="flw-muted">Choose target exam levels and open sample listening, reading, grammar, speaking, or writing tasks.</p></a>
                <article id="flw-teacher" class="flw-card accent-yellow"><p class="flw-page-kicker">Teacher</p><h3>Feedback Queue</h3><p class="flw-muted">Review speaking recordings, writing tasks, quiz results, and teacher comments.</p></article>
                <article id="flw-collaboration" class="flw-card accent-green"><p class="flw-page-kicker">Collaboration</p><h3>Practice with people</h3><p class="flw-muted">Small daily exchanges make speaking and writing feel normal.</p></article>
            </section>
        </div>
        <div class="flw-hidden-maincontent" hidden aria-hidden="true">{{{maincontent}}}</div>
    </main>

    {{{ output.standard_after_main_region_html }}}
</div>
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
