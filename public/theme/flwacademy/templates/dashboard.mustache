                    <article class="flw-dashboard-card flw-unit-panel" id="unit-map"><h2>{{#str}}currentunitmap, theme_flwacademy{{/str}}</h2><p class="flw-card-subtitle"><strong>{{currentcourse.subtitle}}</strong>&nbsp;&nbsp; {{currentcourse.name}}</p><div class="flw-unit-grid">
