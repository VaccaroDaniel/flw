        .flw-dashboard-top-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:20px;min-height:279px;align-items:stretch}.flw-continue-panel{padding:18px 16px 16px}.flw-continue-content{display:grid;grid-template-columns:minmax(0,1fr) 165px;grid-template-rows:1fr auto;gap:8px 19px;align-items:start;margin-top:3px}.flw-course-title-row{display:grid;grid-template-columns:77px minmax(0,1fr);align-items:start;gap:13px;min-width:0}.flw-course-title-row>img{width:76px;height:86px;object-fit:contain;object-position:center;padding:2px;margin-top:10px}.flw-course-title-row h3{font-size:20px;margin:6px 0 2px;color:#101b3b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}.flw-course-title-row strong{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}.flw-course-title-row p{font-size:13px;color:#5d6a85;margin:3px 0 13px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.flw-lesson-progress{height:5px;background:#e7e9ee;border-radius:8px;overflow:hidden;width:100%}.flw-lesson-progress i{display:block;height:100%;background:var(--flw-rd-blue);border-radius:8px}.flw-progress-meta{display:flex;justify-content:space-between;color:#68758c;font-size:11px;margin-top:6px}.flw-continue-actions{grid-column:1/-1;display:flex;align-items:center;gap:24px;margin-top:3px}.flw-continue-actions .flw-lesson-button{width:171px;height:42px;padding:0 20px;justify-content:space-between;font-size:13px}.flw-continue-actions>a:not(.flw-lesson-button),.flw-continue-actions button{border:0;background:none;color:var(--flw-rd-blue);font-size:12px;cursor:pointer;padding:0;white-space:nowrap}.flw-pagoda-photo{width:165px;height:157px;object-fit:cover;border-radius:8px;grid-column:2;grid-row:1;align-self:start}.flw-todays-panel{padding:17px 16px}.flw-todays-panel>.flw-card-heading{margin-bottom:9px}.flw-today-row{min-height:62px;border:1px solid #e2e5eb;border-radius:10px;displ