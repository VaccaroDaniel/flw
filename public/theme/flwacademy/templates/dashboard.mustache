                    <article class="flw-dashboard-card flw-checkpoint-panel" id="checkpoint"><h2>{{#str}}upcomingcheckpoint, theme_flwacademy{{/str}}</h2><div class="flw-checkpoint-info"><img src="{{redesigncheckpointcresturl}}" alt="{{checkpoint.title}} {{#str}}crest, theme_flwacademy{{/str}}" loading="lazy" decoding="async"><div><strong>{{checkpoint.title}}</strong><p>{{checkpoint.meta}}</p></div></div><a class="flw-primary-button" href="{{checkpoint.url}}">{{#str}}preparenow, theme_flwacademy{{/str}}</a></article>
