    <style>
        html,body.flw-dashboard-page{height:auto!important;min-height:100%!important;overflow-x:hidden!important;overflow-y:auto!important}.flw-dashboard-page,.flw-dashboard-page #page-wrapper{margin:0;background:#eef0f3;color:var(--flw-rd-text);font-family:Arial,Helvetica,sans-serif;line-height:1.35}.flw-dashboard-page #page-wrapper.flw-dashboard-wrapper{height:auto!important;min-height:100vh!important;overflow:visible!important}
