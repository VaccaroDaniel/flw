    <div class="flw-dashboard-shell">
        <header class="flw-dashboard-header" hidden aria-hidden="true">
            <a class="flw-logo" href="{{frontpageurl}}" aria-label="{{#str}}flwhome, theme_flwacademy{{/str}}">FLW</a>
            <div class="flw-course-picker-wrap">
                <button class="flw-course-picker" type="button" data-flw-dropdown-toggle="course" aria-expanded="false" aria-controls="flw-course-menu"><img src="{{currentworldcresturl}}" alt="" decoding="async"><span>{{currentworldname}}</span><b>⌄</b></button>
                <div class="flw-dropdown" id="flw-course-menu" data-flw-dropdown="course">
                    {{#learninglanguages}}<a href="{{selfstudycategoryurl}}">{{label}} {{#str}}world, theme_flwacademy{{/str}}</a>{{/learninglanguages}}
                </div>
            </div>
            <label class="flw-dashboard-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4.2 4.2"></path></svg><input type="search" placeholder="{{#str}}dashboardsearchplaceholder, theme_flwacademy{{/str}}"></label>
            <button class="flw-bell-button" type="button" aria-label="{{#str}}notifications, theme_flwacademy{{/str}}"><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 6-2.5 6.5-2.5 8h17C20.5 15.5 18 15 18 9Z"></path><path d="M10 21h4"></path></svg></button>
            <div class="flw-profile-wrap">
                <button class="flw-profile-button" type="button" data-flw-dropdown-toggle="profile" aria-expanded="false" aria-controls="flw-profile-menu">{{{userpicturehtml}}}<div><strong>{{userfullname}}</strong><span>{{#str}}level, theme_flwacademy{{/str}} {{journey.level}}</span></div><b>⌄</b></button>
                <div class="flw-dropdown" id="flw-profile-menu" data-flw-dropdown="profile"><a href="{{profileurl}}">{{#str}}profile, theme_flwacademy{{/str}}</a><a href="{{logouturl}}">{{#str}}logout, theme_flwacademy{{/str}}</a></div>
            </div>
            <button class="flw-dashboard-menu-button" data-flw-sidebar-toggle aria-label="{{#str}}opendashboardnavigation, theme_flwacademy{{/str}}" aria-expanded="false">☰</button>
        </header>

        <div class="flw-dashboard-body-grid">
            <main id="page" data-region="mainpage" data-usertour="scroller" class="flw-dashboard-main">
                <section class="flw-dashboard-greeting">
                    <div><h1>{{#str}}goodevening, theme_flwacademy{{/str}}, {{userfullname}}</h1><p>{{#str}}dashboardencouragement, theme_flwacademy{{/str}}</p></div>
                    <article class="flw-rank-card"><span class="flw-rank-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 4h8v3a4 4 0 0 1-8 0Z"/><path d="M6 4h12M10 11v3a4 4 0 0 1-4 4h12a4 4 0 0 1-4-4v-3M9 21h6"/></svg></span><div><strong>{{rank.title}}</strong><p>{{rank.text}}</p></div><b>›</b></article>
                    <article class="flw-streak-card flw-dashboard-streak-inline"><div class="flw-streak-top"><svg class="flw-streak-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22c3.9 0 7-2.7 7-6.6 0-2.9-1.5-5-3.9-7.1-.4 1.7-1.2 2.9-2.3 3.7.1-3.1-1.2-5.8-4.1-8C8.5 7.3 5 10 5 15.4 5 19.3 8.1 22 12 22Z"></path><path d="M9.2 16.7c0-1.6.9-2.9 2.5-4 .2 1.4.9 2.3 2.1 3 .7.5 1 1.1 1 2 0 1.7-1.3 2.8-2.8 2.8s-2.8-1.1-2.8-3.8Z"></path></svg><div class="flw-streak-copy"><strong>{{streak.summary}}</strong><p>{{streak.weeklabel}}</p></div></div><div class="flw-week-labels">{{#streak.week}}<span>{{label}}</span>{{/streak.week}}</div><div class="flw-week-dots">{{#streak.week}}<i class="{{#active}}is-active{{/active}}">{{#active}}✓{{/active}}</i>{{/streak.week}}</div></article>
                </section>
                {{#hascupkpcontrolcenter}}
                {{{cupkpcontrolcenterhtml}}}
                {{/hascupkpcontrolcenter}}

                <section class="flw-dashboard-top-grid">
                    <article class="flw-dashboard-card flw-continue-panel" id="continue">
                        <h2>{{#str}}continuelearning, theme_flwacademy{{/str}}</h2>
                        <div class="flw-continue-content">
                            <div class="flw-course-title-row"><img src="{{currentcourse.imageurl}}" alt="{{currentworldname}} crest" loading="lazy" decoding="async"><div><h3>{{currentcourse.name}}</h3><strong>{{currentcourse.subtitle}}</strong><p>{{currentcourse.summary}}</p><div class="flw-lesson-progress"><i style="width:{{currentcourse.progress}}"></i></div><div class="flw-progress-meta"><span>{{currentcourse.progresslabel}}</span><span>{{currentcourse.progressmeta}}</span></div></div></div>
                            <img class="flw-pagoda-photo" src="{{redesignpagodaurl}}" alt="{{#str}}pagodaalt, theme_flwacademy{{/str}}" loading="lazy" decoding="async">
                            <div class="flw-continue-actions"><a class="flw-primary-button flw-lesson-button" href="{{currentcourse.continueurl}}">{{#str}}continuelesson, theme_flwacademy{{/str}} <b>›</b></a><a href="{{currentcourse.overviewurl}}">{{#str}}openunitoverview, theme_flwacademy{{/str}}</a><a href="{{currentcourse.restarturl}}">↻&nbsp; {{#str}}restartlesson, theme_flwacademy{{/str}}</a></div>
                        </div>
                    </article>
                    <article class="flw-dashboard-card flw-todays-panel" id="today">
                        <div class="flw-card-heading"><h2>{{#str}}todayslearning, theme_flwacademy{{/str}}</h2><a href="{{currentcourse.url}}">{{#str}}viewfullplan, theme_flwacademy{{/str}}</a></div>
                        {{#todayitems}}
                        <a class="flw-today-row" href="{{url}}"><span class="flw-round-icon {{class}}"><svg viewBox="0 0 24 24"><path d="M5 13v-2a7 7 0 0 1 14 0v2"></path><path d="M5 12H3v5h4v-5H5ZM19 12h2v5h-4v-5h2Z"></path></svg></span><div><strong>{{title}}</strong><p>{{meta}}</p></div><span>{{time}}&nbsp; ›</span></a>
                        {{/todayitems}}
                    </article>
                </section>

                <section class="flw-dashboard-middle-grid">
                    <article class="flw-dashboard-card flw-journey-panel"><h2>{{#str}}coursejourney, theme_flwacademy{{/str}}</h2><p class="flw-card-subtitle">{{#str}}yourcefrprogress, theme_flwacademy{{/str}}</p><div class="flw-cefr-labels">{{#journey.steps}}<span class="{{class}}">{{label}}</span>{{/journey.steps}}</div><div class="flw-cefr-track" style="--fill:{{journey.fillwidth}}">{{#journey.steps}}<b class="flw-cefr-step {{class}}">{{#checked}}✓{{/checked}}</b>{{/journey.steps}}</div><div class="flw-journey-summary"><p>{{#str}}youarehere, theme_flwacademy{{/str}}</p><strong>{{journey.level}} <small>{{journey.small}}</small></strong><span>{{journey.progresslabel}}</span></div><a href="{{journey.reporturl}}">{{#str}}seefullprogress, theme_flwacademy{{/str}}</a></article>
                    <article class="flw-dashboard-card flw-skills-panel"><div class="flw-card-heading"><h2>{{#str}}fourskillprogress, theme_flwacademy{{/str}}</h2><a href="{{journey.reporturl}}">{{#str}}viewdetails, theme_flwacademy{{/str}}</a></div>
                        {{#skillrows}}
