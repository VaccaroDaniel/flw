{{!
    @template theme_flwacademy/flw_school_category

    FLW School course category page.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block flw-school-wrapper">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}
    {{> theme_flwacademy/flw_tools_group }}

    <style>
        :root{--flw-bg:#f7f9fd;--flw-surface:#fff;--flw-surface-strong:#f7f9fd;--flw-soft:#f4f7ff;--flw-ink:#111936;--flw-muted:#5f6d8d;--flw-line:#dbe6ff;--flw-teal:#0a4be8;--flw-teal-dark:#082a84;--flw-coral:#e85d4f;--flw-green:#327be1;--flw-yellow:#f2b84b;--flw-blue:#3278bd;--flw-radius:8px;--flw-shadow:0 12px 30px rgba(23,36,42,.09)}
        .flw-school-category-page{margin:0;background:var(--flw-bg);color:var(--flw-ink);font-family:Inter,"Segoe UI",Arial,sans-serif;line-height:1.5}
        .flw-school-main{width:min(1280px,calc(100% - 32px));margin:0 auto;padding:86px 0 60px}
        .flw-stack{display:grid;gap:22px}
        .flw-page-kicker{margin:0 0 8px;color:var(--flw-teal-dark)!important;font-size:13px;font-weight:800;text-transform:uppercase}
        .flw-sub-banner{position:relative;min-height:230px;display:grid;align-items:center;overflow:hidden;padding:32px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;box-shadow:var(--flw-shadow)}
        .flw-sub-banner:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(255,255,255,.70),rgba(255,255,255,.06))}
        .flw-sub-banner img{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center 58%}
        .flw-sub-banner > div{position:relative;z-index:2;max-width:760px}
        .flw-sub-banner .flw-prototype-title{margin:0 0 12px;color:var(--flw-ink);font-size:42px;line-height:1.08;font-weight:700}
        .flw-sub-banner p:not(.flw-page-kicker):not(.flw-prototype-title){max-width:780px;margin:10px 0 0;color:#405477;font-size:15px}
        .flw-band{width:100%;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface);box-shadow:var(--flw-shadow)}
        .flw-band-inner{padding:24px}
        .flw-section{margin-top:22px}
        .flw-section-head{display:flex;align-items:end;justify-content:space-between;gap:14px;margin-bottom:12px}
        .flw-section-lead{margin-bottom:12px}
        .flw-section-lead h2{margin:0;color:var(--flw-ink);font-size:24px;line-height:1.18;font-weight:700}
        .flw-school-grid{display:grid;grid-template-columns:repeat(1,minmax(0,1fr));gap:14px}
        .flw-school-course{min-width:0;display:grid;gap:12px;align-content:start;padding:18px;border:1px solid var(--flw-line);border-top:5px solid var(--flw-teal);border-radius:var(--flw-radius);background:var(--flw-surface)}
        .flw-school-course.accent-blue{border-top-color:var(--flw-blue)}
        .flw-school-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
        .flw-school-tag{display:inline-flex;min-height:28px;align-items:center;padding:5px 9px;border-radius:var(--flw-radius);background:var(--flw-surface-strong);color:var(--flw-teal-dark);font-size:12px;font-weight:900}
        .flw-school-course h3{margin:0 0 2px;color:var(--flw-ink);font-size:18px;line-height:1.25;font-weight:700}
        .flw-school-year-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
        .flw-school-year{display:block;min-width:0;padding:10px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface-strong);color:var(--flw-ink)!important;text-decoration:none!important}
        .flw-school-year:hover{border-color:var(--flw-teal);background:#fff}
        .flw-school-year strong{display:block;margin-bottom:5px;line-height:1.2}
        .flw-school-year p{margin:0;color:var(--flw-muted);font-size:13px;line-height:1.35}
        .flw-course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
        .flw-course-card{min-width:0;display:block;padding:18px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;text-decoration:none!important}
        .flw-course-card:hover{transform:translateY(-2px);border-color:var(--flw-teal)}
        .flw-course-card strong{display:block;margin-bottom:6px;color:var(--flw-ink);font-size:18px;line-height:1.25;font-weight:700}
        .flw-course-card span,.flw-muted{color:var(--flw-muted)!important;font-size:13px}
        .flw-course-card{border-top:5px solid var(--flw-teal)}
        .flw-course-card p{margin:8px 0 0;color:var(--flw-muted)}
        .flw-empty{padding:18px;border:1px dashed var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.7);color:var(--flw-muted)}
        .flw-back-link{display:inline-flex;margin-top:18px;color:var(--flw-teal-dark)!important;font-weight:700;text-decoration:none!important}
        .flw-hidden-maincontent{display:none!important}
        .flw-school-category-page{background:#eef0f3;color:#111936;font-family:Arial,Helvetica,sans-serif;line-height:1.35}
        .flw-school-main{width:min(1428px,calc(100% - 20px));padding:84px 0 60px}
        .flw-band,.flw-school-course,.flw-school-year,.flw-course-card{border-color:#e5e8ef;border-radius:12px;background:#fff;box-shadow:0 4px 14px rgba(23,39,79,.10)}
        .flw-sub-banner{border-color:#e5e8ef;border-radius:12px;box-shadow:0 4px 14px rgba(23,39,79,.10)}
        .flw-page-kicker,.flw-school-tag,.flw-back-link{color:#082a84!important;font-size:13px;font-weight:700}
        .flw-sub-banner .flw-prototype-title,.flw-section-lead h2,.flw-section-head h2{font-family:Georgia,"Times New Roman",serif;color:#101a3a;font-weight:700}
        .flw-sub-banner .flw-prototype-title{font-size:42px;line-height:1.08;letter-spacing:-1.4px}
        .flw-section-lead h2,.flw-section-head h2{font-size:26px;line-height:1.15}
        .flw-school-course h3,.flw-course-card strong{color:#10162b;font-size:18px;font-weight:700}
        .flw-sub-banner p:not(.flw-page-kicker):not(.flw-prototype-title){margin:10px 0 0;color:#405477!important;font-size:15px;line-height:1.35}.flw-school-year p,.flw-course-card span,.flw-course-card p,.flw-muted{color:#5f6d8d!important;font-size:13px;line-height:1.35}
        .flw-school-course,.flw-course-card{border-top-color:#0a4be8}.flw-school-course.accent-blue{border-top-color:#327be1}
        @media(max-width:980px){.flw-school-year-list,.flw-course-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.flw-sub-banner .flw-prototype-title{font-size:34px}}
        @media(max-width:640px){.flw-school-main{width:min(100% - 22px,1280px);padding-top:76px}.flw-sub-banner{padding:20px}.flw-school-year-list,.flw-course-grid{grid-template-columns:1fr}}
    </style>

    <main id="page" class="flw-school-main flw-stack">
        <section class="flw-sub-banner" aria-label="{{#str}}categorydescription, theme_flwacademy{{/str}}">
            <img src="{{heroimageurl}}" alt="">
            <div>
            <p class="flw-page-kicker">{{language}}</p>
            <h1 class="flw-prototype-title">{{title}}</h1>
            {{#hasdescription}}
            {{{description}}}
            {{/hasdescription}}
            </div>
        </section>

        <section class="flw-band" aria-label="{{#str}}primarysecondaryschool, theme_flwacademy{{/str}}">
            <div class="flw-band-inner">
            <div class="flw-section-lead">
                <p class="flw-page-kicker">{{#str}}primarysecondaryschool, theme_flwacademy{{/str}}</p>
                <h2>{{#str}}sixyearcoursesfor, theme_flwacademy{{/str}} {{language}}</h2>
            </div>
            {{#hasprimarysecondarycategories}}
            <div class="flw-school-grid">
                <article class="flw-school-course">
                    <h3>{{language}} {{#str}}schoolcourse, theme_flwacademy{{/str}}</h3>
                    <div class="flw-school-year-list">
                        {{#primarycategories}}
                        <a class="flw-school-year" href="{{url}}">
                            <strong>{{name}}</strong>
                            {{#hasdescription}}{{{description}}}{{/hasdescription}}
                        </a>
                        {{/primarycategories}}
                        {{#secondarycategories}}
                        <a class="flw-school-year" href="{{url}}">
                            <strong>{{name}}</strong>
                            {{#hasdescription}}{{{description}}}{{/hasdescription}}
                        </a>
                        {{/secondarycategories}}
                    </div>
                </article>
            </div>
            {{/hasprimarysecondarycategories}}
            {{^hasprimarysecondarycategories}}<div class="flw-empty">{{#str}}noprimarysecondarycategories, theme_flwacademy{{/str}}</div>{{/hasprimarysecondarycategories}}
            </div>
        </section>

        <section class="flw-band" aria-labelledby="flw-university-title">
            <div class="flw-band-inner">
            <div class="flw-section-lead">
                <p class="flw-page-kicker">{{#str}}university, theme_flwacademy{{/str}}</p>
                <h2 id="flw-university-title">{{#str}}twoyearcoursesfor, theme_flwacademy{{/str}} {{language}}</h2>
            </div>
            {{#hasuniversitycategories}}
            <div class="flw-school-grid">
                <article class="flw-school-course accent-blue">
                    <h3>{{language}} {{#str}}universitycourse, theme_flwacademy{{/str}}</h3>
                    <div class="flw-school-year-list">
                        {{#universitycategories}}
                        <a class="flw-school-year" href="{{url}}">
                            <strong>{{name}}</strong>
                            {{#hasdescription}}{{{description}}}{{/hasdescription}}
                            {{^hasdescription}}<p>{{coursecount}} {{#str}}courses, theme_flwacademy{{/str}}</p>{{/hasdescription}}
                        </a>
                        {{/universitycategories}}
                    </div>
                </article>
            </div>
            {{/hasuniversitycategories}}
            {{^hasuniversitycategories}}<div class="flw-empty">{{#str}}nouniversitycategories, theme_flwacademy{{/str}}</div>{{/hasuniversitycategories}}
            </div>
        </section>
        
        <section class="flw-band" aria-labelledby="flw-courses-title">
            <div class="flw-band-inner">
            <div class="flw-section-head"><h2 id="flw-courses-title">{{language}} {{#str}}courses, theme_flwacademy{{/str}}</h2></div>
            {{#hascourses}}
            <div class="flw-course-grid">
                {{#courses}}
                <a class="flw-course-card" href="{{url}}">
                    <strong>{{name}}</strong>
                    <span>{{categoryname}} · {{shortname}}</span>
                    {{#summary}}<p>{{summary}}</p>{{/summary}}
                </a>
                {{/courses}}
            </div>
            {{/hascourses}}
            {{^hascourses}}<div class="flw-empty">{{#str}}no, theme_flwacademy{{/str}} {{language}} {{#str}}schoolcoursesadded, theme_flwacademy{{/str}}</div>{{/hascourses}}
            </div>
        </section>

        <div class="flw-hidden-maincontent">{{{maincontent}}}</div>
    </main>
</div>
{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
