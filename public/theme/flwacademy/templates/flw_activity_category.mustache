{{!
    @template theme_flwacademy/flw_activity_category

    FLW Practice and Exam category page.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block flw-activity-wrapper">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}
    {{> theme_flwacademy/flw_tools_group }}

    <style>
        .flw-school-category-page{margin:0;background:var(--flw-bg);color:var(--flw-ink);font-family:Inter,"Segoe UI",Arial,sans-serif;line-height:1.5}
        .flw-page-shell{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:86px 0 56px}.flw-stack{display:grid;gap:22px}
        .flw-band,.flw-card,.flw-score-box{border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface);box-shadow:var(--flw-shadow);color:var(--flw-ink)!important}.flw-band-inner{padding:24px}
        .flw-sub-banner{position:relative;min-height:250px;display:grid;align-items:center;overflow:hidden;padding:32px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;box-shadow:var(--flw-shadow)}.flw-sub-banner:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(255,255,255,.70),rgba(255,255,255,.06))}.flw-sub-banner img{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center 58%}.flw-sub-banner>div{position:relative;z-index:2;max-width:760px}
        .flw-page-kicker{margin:0 0 8px;color:var(--flw-teal-dark)!important;font-size:13px;font-weight:800;text-transform:uppercase}.flw-sub-banner h1,.flw-sub-banner .flw-prototype-title{margin:0 0 12px;color:var(--flw-ink);font-size:42px;line-height:1.08;font-weight:700}.flw-lead,.flw-sub-banner p:not(.flw-page-kicker):not(.flw-prototype-title){max-width:780px;color:var(--flw-muted)!important;font-size:18px}
        .flw-practice-hero-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:14px;align-items:stretch}.flw-score-box{display:grid;gap:12px;align-content:center;padding:22px;border-top:5px solid var(--flw-yellow)}.flw-score-box h2{margin:0;color:var(--flw-teal-dark);font-size:48px;line-height:1}.flw-score-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.flw-score-grid>div{display:grid;gap:3px;min-height:68px;padding:9px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface-strong)}.flw-score-grid span{color:var(--flw-muted);font-size:12px;font-weight:800}
        .flw-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:14px}.flw-grid{display:grid;gap:14px}.flw-grid.five{grid-template-columns:repeat(5,minmax(0,1fr))}.flw-grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.flw-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
        .flw-card{min-width:0;padding:18px;color:var(--flw-ink)!important;text-decoration:none!important}.flw-card p:not(.flw-muted):not(.flw-page-kicker),.flw-card li,.flw-card small,.flw-band p:not(.flw-muted):not(.flw-page-kicker),.flw-band li,.flw-level-card p,.flw-level-card div{color:var(--flw-ink)!important}.flw-card.accent-teal{border-top:5px solid var(--flw-teal)}.flw-card.accent-coral{border-top:5px solid var(--flw-coral)}.flw-card.accent-green{border-top:5px solid var(--flw-green)}.flw-card.accent-yellow{border-top:5px solid var(--flw-yellow)}.flw-card.accent-blue{border-top:5px solid var(--flw-blue)}.flw-card h3{margin:0 0 8px;color:var(--flw-ink);font-size:18px;line-height:1.25;font-weight:700}.flw-card p{margin-top:0}.flw-muted{color:var(--flw-muted)!important}
        .flw-watch-image-card{display:grid;gap:9px;min-height:242px;padding:10px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;text-decoration:none!important}.flw-watch-image-card img{width:100%;aspect-ratio:16/10;border-radius:calc(var(--flw-radius) - 1px);object-fit:cover}.flw-watch-image-card span{font-size:18px;font-weight:900}
        .flw-level-card{display:grid;gap:10px;min-height:170px;padding:16px;border:1px solid var(--flw-line);border-top:5px solid var(--flw-teal);border-radius:var(--flw-radius);background:#fff;color:var(--flw-ink)!important;text-decoration:none!important}.flw-level-card strong{display:grid;min-height:72px;place-items:center;border-radius:var(--flw-radius);background:var(--flw-surface-strong);color:var(--flw-teal-dark);font-size:28px}
        .flw-course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.flw-empty{padding:18px;border:1px dashed var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.7);color:var(--flw-muted)}
        .flw-hidden-maincontent{display:none!important}.flw-back-link{display:inline-flex;color:var(--flw-teal-dark)!important;font-weight:700;text-decoration:none!important}
        .flw-school-category-page{background:#eef0f3;color:#111936;font-family:Arial,Helvetica,sans-serif;line-height:1.35}
        .flw-page-shell{width:min(1428px,calc(100% - 20px));padding:84px 0 56px}
        .flw-band,.flw-card,.flw-score-box,.flw-watch-image-card,.flw-level-card{border-color:#e5e8ef;border-radius:12px;background:#fff;box-shadow:0 4px 14px rgba(23,39,79,.10)}
        .flw-sub-banner{border-color:#e5e8ef;border-radius:12px;box-shadow:0 4px 14px rgba(23,39,79,.10)}
        .flw-page-kicker,.flw-back-link{color:#082a84!important;font-size:13px;font-weight:700}
        .flw-sub-banner h1,.flw-sub-banner .flw-prototype-title,.flw-section-heading h2{font-family:Georgia,"Times New Roman",serif;color:#101a3a;font-weight:700}
        .flw-sub-banner h1,.flw-sub-banner .flw-prototype-title{font-size:42px;line-height:1.08;letter-spacing:-1.4px}
        .flw-section-heading h2{font-size:26px;line-height:1.15}
        .flw-card h3,.flw-watch-image-card span,.flw-level-card strong{color:#10162b;font-size:18px;font-weight:700}
        .flw-lead,.flw-sub-banner p:not(.flw-page-kicker):not(.flw-prototype-title),.flw-muted,.flw-card p,.flw-band p,.flw-level-card p{color:#5f6d8d!important;font-size:13px;line-height:1.35}
        .flw-score-box h2{color:#0a4be8;font-family:Georgia,"Times New Roman",serif;font-size:48px;font-weight:700}
        .flw-card.accent-teal,.flw-level-card,.flw-course-grid .flw-card{border-top-color:#0a4be8}.flw-card.accent-blue{border-top-color:#327be1}.flw-card.accent-coral{border-top-color:#e85d4f}.flw-card.accent-green{border-top-color:#327be1}.flw-card.accent-yellow,.flw-score-box{border-top-color:#f38a00}
        .flw-practice-page .flw-card,.flw-practice-page .flw-level-card,.flw-practice-page .flw-score-box{border-top-width:1px}
        .flw-practice-page .flw-grid.five .flw-card.is-active{border-color:#0a4be8!important;background:linear-gradient(135deg,#0a4be8 0%,#327be1 100%)!important;color:#fff!important;box-shadow:0 10px 24px rgba(10,75,232,.22)!important;transform:translateY(-1px)}
        .flw-practice-page .flw-grid.five .flw-card.is-active .flw-page-kicker,.flw-practice-page .flw-grid.five .flw-card.is-active h3,.flw-practice-page .flw-grid.five .flw-card.is-active p{color:#fff!important}
        .flw-practice-page .flw-grid.five .flw-card.is-active .flw-page-kicker{opacity:.82}
        @media(max-width:980px){.flw-practice-hero-grid,.flw-grid.five,.flw-grid.four,.flw-course-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.flw-sub-banner h1,.flw-sub-banner .flw-prototype-title{font-size:34px}}
        @media(max-width:640px){.flw-page-shell{width:min(100% - 22px,1180px);padding-top:76px}.flw-sub-banner,.flw-band-inner{padding:18px}.flw-practice-hero-grid,.flw-grid.five,.flw-grid.four,.flw-grid.three,.flw-course-grid{grid-template-columns:1fr}}
    </style>

    <main id="page" class="flw-page-shell flw-stack {{#ispractice}}flw-practice-page{{/ispractice}}{{#isexam}}flw-exam-page{{/isexam}}">
        {{#ispractice}}
        <section class="flw-practice-hero-grid">
            <section class="flw-sub-banner">
                <img src="{{practiceheroimageurl}}" alt="" decoding="async" fetchpriority="high">
                <div>
                    <p class="flw-page-kicker">{{#str}}practice, theme_flwacademy{{/str}}</p>
                    <h1>{{practiceherotitle}}</h1>
                    {{#hasdescription}}{{{description}}}{{/hasdescription}}
                    {{^hasdescription}}<p>{{practiceherotext}}</p>{{/hasdescription}}
                </div>
            </section>
            <aside class="flw-score-box">
                <p class="flw-page-kicker">{{#str}}practicescore, theme_flwacademy{{/str}}</p>
                <h2>0%</h2>
                <p class="flw-muted">{{language}} {{#str}}practice, theme_flwacademy{{/str}} | 0 {{#str}}activities, theme_flwacademy{{/str}} | 0 {{#str}}hours, theme_flwacademy{{/str}}</p>
                <div class="flw-score-grid">
                    <div><span>{{#str}}activities, theme_flwacademy{{/str}}</span><strong>0</strong></div>
                    <div><span>{{#str}}levelrange, theme_flwacademy{{/str}}</span><strong>{{#str}}easyhard, theme_flwacademy{{/str}}</strong></div>
                    <div><span>{{#str}}history, theme_flwacademy{{/str}}</span><strong>{{#str}}ready, theme_flwacademy{{/str}}</strong></div>
                    <div><span>{{#str}}profile, theme_flwacademy{{/str}}</span><strong>{{#str}}saved, theme_flwacademy{{/str}}</strong></div>
                </div>
            </aside>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading"><div><p class="flw-page-kicker">{{#str}}choosewhatyouwant, theme_flwacademy{{/str}}</p><h2>{{#str}}openpracticecategory, theme_flwacademy{{/str}}</h2></div></div>
                <div class="flw-grid five">
                    {{#practiceitems}}
                    <a class="flw-card {{accent}}{{#isactive}} is-active{{/isactive}}" href="{{url}}"{{#isactive}} aria-current="page"{{/isactive}}><p class="flw-page-kicker">{{label}}</p><h3>{{title}}</h3><p class="flw-muted">{{text}}</p></a>
                    {{/practiceitems}}
                </div>
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading"><div><p class="flw-page-kicker">{{#str}}watchcategories, theme_flwacademy{{/str}}</p><h2>{{#str}}practiceimageselection, theme_flwacademy{{/str}}</h2></div></div>
                <div class="flw-grid five">
                    {{#watchcards}}
                    <article class="flw-watch-image-card"><img src="{{imageurl}}" alt="" loading="lazy" decoding="async"><span>{{title}}</span><p class="flw-muted">{{text}}</p></article>
                    {{/watchcards}}
                </div>
            </div>
        </section>
        {{/ispractice}}

        {{#isexam}}
        <section class="flw-sub-banner">
            <img src="{{examheroimageurl}}" alt="" decoding="async" fetchpriority="high">
            <div>
                <p class="flw-page-kicker">{{#str}}exam, theme_flwacademy{{/str}}</p>
                <h1>{{language}} {{#str}}exampractice, theme_flwacademy{{/str}}</h1>
                {{#hasdescription}}{{{description}}}{{/hasdescription}}
                {{^hasdescription}}<p>{{#str}}examcategoryintro, theme_flwacademy{{/str}}</p>{{/hasdescription}}
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-grid three">
                    <article class="flw-card accent-teal"><p class="flw-page-kicker">{{#str}}language, theme_flwacademy{{/str}}</p><h3>{{language}}</h3><p class="flw-muted">{{#str}}languageonlycategories, theme_flwacademy{{/str}}</p></article>
                    <article class="flw-card accent-coral"><p class="flw-page-kicker">{{#str}}examlevel, theme_flwacademy{{/str}}</p><h3>{{selectedlevel}}</h3><p class="flw-muted">{{examframework}} {{#str}}framework, theme_flwacademy{{/str}}</p></article>
                    <article class="flw-card accent-yellow"><p class="flw-page-kicker">{{examframework}}</p><h3>{{#str}}levelpath, theme_flwacademy{{/str}}</h3><p class="flw-muted">{{#str}}openlevelsamples, theme_flwacademy{{/str}}</p></article>
                </div>
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading"><div><p class="flw-page-kicker">{{#str}}examlevel, theme_flwacademy{{/str}}</p><h2>{{#str}}choosetargetexamlevel, theme_flwacademy{{/str}}</h2></div></div>
                {{#hasexamlevels}}
                <div class="flw-grid three">
                    {{#examlevels}}
                    <a class="flw-level-card" href="{{url}}"><strong>{{name}}</strong>{{#hasdescription}}{{{description}}}{{/hasdescription}}</a>
                    {{/examlevels}}
                </div>
                {{/hasexamlevels}}
                {{^hasexamlevels}}<div class="flw-empty">{{#str}}noexamlevelcategories, theme_flwacademy{{/str}}</div>{{/hasexamlevels}}
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-grid four">
                    {{#examsamples}}
                    <article class="flw-card accent-coral"><p class="flw-page-kicker">{{#str}}sample, theme_flwacademy{{/str}} {{index}}</p><h3>{{title}}</h3><p class="flw-muted">{{prompt}}</p><p>{{task}}</p></article>
                    {{/examsamples}}
                </div>
            </div>
        </section>
        {{/isexam}}

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading"><div><p class="flw-page-kicker">{{#str}}courses, theme_flwacademy{{/str}}</p><h2>{{title}} {{#str}}courses, theme_flwacademy{{/str}}</h2></div></div>
                {{#hascourses}}
                <div class="flw-course-grid">
                    {{#courses}}
                    <a class="flw-card accent-teal" href="{{url}}"><h3>{{name}}</h3><p class="flw-muted">{{categoryname}} | {{shortname}}</p>{{#summary}}<p>{{summary}}</p>{{/summary}}</a>
                    {{/courses}}
                </div>
                {{/hascourses}}
                {{^hascourses}}<div class="flw-empty">{{#str}}nocoursescategory, theme_flwacademy{{/str}}</div>{{/hascourses}}
            </div>
        </section>

        <div><a class="flw-back-link" href="{{languagecategoryurl}}">{{#str}}backto, theme_flwacademy{{/str}} {{language}}</a></div>
        <div class="flw-hidden-maincontent">{{{maincontent}}}</div>
    </main>
</div>
{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
