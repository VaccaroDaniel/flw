{{!
    @template theme_flwacademy/flw_language_panel

    Floating FLW learning-language selector.
}}
{{#haslearninglanguages}}
<aside class="flw-language-panel"
       aria-label="Learning language"
       data-current-language-code="{{currentlanguagecode}}"
       data-current-category-type="{{currentcategorytype}}">
    <button type="button"
            class="flw-language-trigger"
            data-flw-language-trigger
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label="Choose learning language">
        <span class="flw-language-trigger-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"></path>
                <path d="M3.6 9h16.8M3.6 15h16.8M12 3c2.1 2.3 3.2 5.3 3.2 9S14.1 18.7 12 21M12 3C9.9 5.3 8.8 8.3 8.8 12S9.9 18.7 12 21"></path>
            </svg>
        </span>
        <span class="flw-language-trigger-copy">
            <span class="flw-language-trigger-title">Learning Language</span>
            <span class="flw-language-trigger-current" data-flw-current-language>English</span>
        </span>
        <span class="flw-language-trigger-chev" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <path d="m7 10 5 5 5-5"></path>
            </svg>
        </span>
    </button>

    <div class="flw-language-popover-card" data-flw-language-popup>
        <div class="flw-language-panel-head">
            <p class="flw-language-panel-title">Choose language</p>
            <span data-flw-language-count></span>
        </div>
        <div class="flw-language-options" role="listbox" aria-label="Choose learning language">
            {{#learninglanguages}}
                <button type="button"
                        class="flw-language-choice{{#isdefault}} is-active{{/isdefault}}"
                        data-flw-language-choice
                        data-language-code="{{code}}"
                        data-language-label="{{label}}"
                        data-category-url="{{categoryurl}}"
                        data-school-category-url="{{schoolcategoryurl}}"
                        data-selfstudy-category-url="{{selfstudycategoryurl}}"
                        data-placement-test-url="{{placementtesturl}}"
                        data-practice-category-url="{{practicecategoryurl}}"
                        data-exam-category-url="{{examcategoryurl}}"
                        data-practice-watch-url="{{practicewatchurl}}"
                        data-practice-listen-url="{{practicelistenurl}}"
                        data-practice-speak-url="{{practicespeakurl}}"
                        data-practice-read-url="{{practicereadurl}}"
                        data-practice-dictate-url="{{practicedictateurl}}"
                        data-exam-1-label="{{exam1label}}"
                        data-exam-1-url="{{exam1url}}"
                        data-exam-2-label="{{exam2label}}"
                        data-exam-2-url="{{exam2url}}"
                        data-exam-3-label="{{exam3label}}"
                        data-exam-3-url="{{exam3url}}"
                        data-exam-4-label="{{exam4label}}"
                        data-exam-4-url="{{exam4url}}"
                        data-exam-5-label="{{exam5label}}"
                        data-exam-5-url="{{exam5url}}"
                        data-exam-6-label="{{exam6label}}"
                        data-exam-6-url="{{exam6url}}"
                        data-nav-school="{{navschool}}"
                        data-nav-selfstudy="{{navselfstudy}}"
                        data-nav-practice="{{navpractice}}"
                        data-nav-dictionary="{{navdictionary}}"
                        data-nav-exam="{{navexam}}"
                        data-nav-teacher="{{navteacher}}"
                        data-nav-collaboration="{{navcollaboration}}"
                        aria-pressed="{{#isdefault}}true{{/isdefault}}{{^isdefault}}false{{/isdefault}}">
                    <span class="flw-language-choice-mark" aria-hidden="true"></span>
                    <span>{{label}}</span>
                </button>
            {{/learninglanguages}}
        </div>
    </div>
</aside>
<style>
    .flw-language-panel{position:fixed;right:24px;bottom:72px;z-index:1090;font-family:"Aptos Display","Segoe UI Variable Text",Inter,"Noto Sans","Helvetica Neue",Arial,sans-serif;color:#17242a}
    .flw-language-trigger{min-width:190px;min-height:48px;display:inline-flex;align-items:center;gap:10px;padding:7px 9px;border:1px solid rgba(8,127,140,.18);border-radius:999px;background:rgba(255,255,255,.96);color:#17242a;box-shadow:0 16px 40px rgba(23,36,42,.14);backdrop-filter:saturate(1.18) blur(16px);cursor:grab;touch-action:none;user-select:none;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease,background-color .16s ease}
    .flw-language-trigger:hover,.flw-language-trigger:focus{border-color:rgba(8,127,140,.32);background:#fff;box-shadow:0 20px 48px rgba(23,36,42,.18);outline:0;transform:translateY(-1px)}
    .flw-language-trigger-icon{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:50%;background:linear-gradient(135deg,#087f8c,#4f9d54);color:#fff;box-shadow:0 8px 18px rgba(8,127,140,.24)}
    .flw-language-trigger-icon svg,.flw-language-trigger-chev svg{width:18px;height:18px;display:block;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .flw-language-trigger-copy{min-width:0;display:grid;text-align:left;line-height:1.12}
    .flw-language-trigger-title{color:#5d6b72;font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
    .flw-language-trigger-current{max-width:108px;overflow:hidden;color:#10252d;font-size:15px;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
    .flw-language-trigger-chev{width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;margin-left:auto;border-radius:50%;color:#075a64;background:#f0f6f4;transition:transform .16s ease}
    .flw-language-popover-card{position:absolute;right:0;bottom:calc(100% + 12px);width:228px;padding:12px;border:1px solid rgba(216,227,223,.95);border-radius:14px;background:rgba(255,255,255,.98);box-shadow:0 22px 58px rgba(23,36,42,.18);backdrop-filter:saturate(1.18) blur(18px);opacity:0;pointer-events:none;transform:translateY(8px) scale(.98);transform-origin:right bottom;transition:opacity .16s ease,transform .16s ease}
    .flw-language-panel.is-near-top .flw-language-popover-card{top:calc(100% + 12px);bottom:auto;transform-origin:right top}
    .flw-language-panel.is-near-left .flw-language-popover-card{left:0;right:auto;transform-origin:left bottom}
    .flw-language-panel.is-near-top.is-near-left .flw-language-popover-card{transform-origin:left top}
    .flw-language-panel:hover:not(.is-closed-after-select) .flw-language-popover-card,.flw-language-panel:focus-within:not(.is-closed-after-select) .flw-language-popover-card,.flw-language-panel.is-open:not(.is-closed-after-select) .flw-language-popover-card{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}
    .flw-language-panel:hover:not(.is-closed-after-select) .flw-language-trigger-chev,.flw-language-panel:focus-within:not(.is-closed-after-select) .flw-language-trigger-chev,.flw-language-panel.is-open:not(.is-closed-after-select) .flw-language-trigger-chev{transform:rotate(180deg)}
    .flw-language-panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px;padding:0 2px}
    .flw-language-panel-title{margin:0;color:#5d6b72!important;font-size:12px;font-weight:760;letter-spacing:.03em;text-transform:uppercase}
    .flw-language-panel-head span{min-width:26px;height:22px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;background:#f0f6f4;color:#075a64;font-size:11px;font-weight:720}
    .flw-language-options{display:grid;gap:5px}
    .flw-language-choice{min-height:38px;width:100%;display:flex;align-items:center;gap:9px;padding:7px 9px;border:0;border-radius:10px;background:transparent;color:#31484f;font-size:14px;font-weight:560;line-height:1.2;text-align:left;white-space:nowrap;cursor:pointer;transition:background-color .14s ease,color .14s ease,transform .14s ease}
    .flw-language-choice:hover,.flw-language-choice:focus{background:#f0f6f4;color:#075a64;outline:0;transform:translateX(1px)}
    .flw-language-choice.is-active{background:linear-gradient(135deg,#087f8c,#0b8f72);color:#fff;box-shadow:0 8px 20px rgba(8,127,140,.18)}
    .flw-language-choice-mark{width:10px;height:10px;flex:0 0 auto;border:1px solid currentColor;border-radius:50%;opacity:.55}
    .flw-language-choice.is-active .flw-language-choice-mark{border-color:#fff;background:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.24);opacity:1}
    .flw-language-panel.is-dragging .flw-language-trigger{cursor:grabbing;box-shadow:0 24px 54px rgba(23,36,42,.22);transform:none}
    .flw-language-panel.is-dragging .flw-language-popover-card{opacity:0!important;pointer-events:none!important}
    @media(max-width:680px){.flw-language-panel{right:12px;bottom:64px}.flw-language-trigger{min-width:52px;width:52px;min-height:52px;padding:8px;justify-content:center}.flw-language-trigger-copy,.flw-language-trigger-chev{display:none}.flw-language-trigger-icon{width:36px;height:36px}.flw-language-popover-card{right:0;width:min(228px,calc(100vw - 24px))}}
</style>
{{#js}}
(function() {
    var storageKey = 'flw.learningLanguage';
    var positionKey = 'flw.learningLanguage.position';
    var cookieKey = 'flw_learning_language';
    var panel = document.querySelector('.flw-language-panel');
    var choices = Array.prototype.slice.call(document.querySelectorAll('[data-flw-language-choice]'));
    var trigger = panel ? panel.querySelector('[data-flw-language-trigger]') : null;
    var triggerLabel = panel ? panel.querySelector('[data-flw-current-language]') : null;
    var countLabel = panel ? panel.querySelector('[data-flw-language-count]') : null;

    if (!panel || !choices.length) {
        return;
    }

    if (countLabel) {
        countLabel.textContent = choices.length;
    }

    function clamp(value, minimum, maximum) {
        return Math.max(minimum, Math.min(maximum, value));
    }

    function getStoredPosition() {
        try {
            return JSON.parse(window.localStorage.getItem(positionKey) || 'null');
        } catch (error) {
            return null;
        }
    }

    function storePosition(left, top) {
        try {
            window.localStorage.setItem(positionKey, JSON.stringify({
                left: Math.round(left),
                top: Math.round(top)
            }));
        } catch (error) {
            // Position memory is optional.
        }
    }

    function updatePanelPlacement(left, top) {
        var viewportWidth = window.innerWidth || document.documentElement.clientWidth || 0;
        var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
        panel.classList.toggle('is-near-top', top < 300);
        panel.classList.toggle('is-near-left', left < 240 || viewportWidth < 520);
        panel.classList.toggle('is-near-bottom', top > viewportHeight - 220);
    }

    function applyPanelPosition(left, top) {
        var rect = panel.getBoundingClientRect();
        var viewportWidth = window.innerWidth || document.documentElement.clientWidth || rect.width;
        var viewportHeight = window.innerHeight || document.documentElement.clientHeight || rect.height;
        var margin = 10;
        var nextLeft = clamp(left, margin, Math.max(margin, viewportWidth - rect.width - margin));
        var nextTop = clamp(top, margin, Math.max(margin, viewportHeight - rect.height - margin));
        panel.style.left = nextLeft + 'px';
        panel.style.top = nextTop + 'px';
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
        updatePanelPlacement(nextLeft, nextTop);
        return {left: nextLeft, top: nextTop};
    }

    function restorePanelPosition() {
        var stored = getStoredPosition();
        if (stored && typeof stored.left === 'number' && typeof stored.top === 'number') {
            applyPanelPosition(stored.left, stored.top);
            return;
        }
        window.setTimeout(function() {
            var rect = panel.getBoundingClientRect();
            updatePanelPlacement(rect.left, rect.top);
        }, 0);
    }

    function readCookie(name) {
        var match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([.$?*|{}()[\]\\/+^])/g, '\\$1') + '=([^;]*)'));
        return match ? decodeURIComponent(match[1]) : '';
    }

    function writeCookie(name, value) {
        document.cookie = name + '=' + encodeURIComponent(value) + '; path=/; max-age=31536000; SameSite=Lax';
    }

    function findChoice(code) {
        return choices.find(function(choice) {
            return choice.getAttribute('data-language-code') === code;
        });
    }

    function normalizeUrl(url) {
        var anchor = document.createElement('a');
        anchor.href = url;
        return anchor.href.replace(/#.*$/, '');
    }

    function openPanel() {
        panel.classList.remove('is-closed-after-select');
        panel.classList.add('is-open');
        if (trigger) {
            trigger.setAttribute('aria-expanded', 'true');
        }
    }

    function closePanel() {
        panel.classList.remove('is-open');
        if (trigger) {
            trigger.setAttribute('aria-expanded', 'false');
        }
    }

    function updateTrigger(label) {
        if (triggerLabel) {
            triggerLabel.textContent = label || 'English';
        }
        if (trigger) {
            trigger.setAttribute('title', 'Learning Language: ' + (label || 'English'));
        }
    }

    function applyLanguage(code, redirectCurrentCategory) {
        var active = findChoice(code) || choices[0];
        var activeCode = active.getAttribute('data-language-code');
        var activeLabel = active.getAttribute('data-language-label');
        var activeUrl = active.getAttribute('data-category-url');
        var categoryUrls = {
            school: active.getAttribute('data-school-category-url') || activeUrl,
            selfstudy: active.getAttribute('data-selfstudy-category-url') || activeUrl,
            practice: active.getAttribute('data-practice-category-url') || activeUrl,
            exam: active.getAttribute('data-exam-category-url') || activeUrl
        };
        var placementTestUrl = active.getAttribute('data-placement-test-url') || categoryUrls.selfstudy;
        var practiceUrls = {
            watch: active.getAttribute('data-practice-watch-url') || categoryUrls.practice,
            listen: active.getAttribute('data-practice-listen-url') || categoryUrls.practice,
            speak: active.getAttribute('data-practice-speak-url') || categoryUrls.practice,
            read: active.getAttribute('data-practice-read-url') || categoryUrls.practice,
            dictate: active.getAttribute('data-practice-dictate-url') || categoryUrls.practice
        };
        var examLinks = [];
        for (var i = 1; i <= 6; i++) {
            examLinks.push({
                label: active.getAttribute('data-exam-' + i + '-label') || '',
                url: active.getAttribute('data-exam-' + i + '-url') || categoryUrls.exam
            });
        }

        try {
            window.localStorage.setItem(storageKey, activeCode);
        } catch (error) {
            // The cookie keeps the selection when local storage is unavailable.
        }
        writeCookie(cookieKey, activeCode);
        updateTrigger(activeLabel);

        choices.forEach(function(choice) {
            var selected = choice === active;
            choice.classList.toggle('is-active', selected);
            choice.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });

        Array.prototype.slice.call(document.querySelectorAll('[data-flw-category-link]')).forEach(function(link) {
            var linkType = link.getAttribute('data-flw-category-link');
            link.setAttribute('href', categoryUrls[linkType] || activeUrl);
            link.setAttribute('data-selected-language', activeCode);
            link.setAttribute('title', activeLabel + ' course category');
        });

        Array.prototype.slice.call(document.querySelectorAll('[data-flw-placement-link]')).forEach(function(link) {
            link.setAttribute('href', placementTestUrl);
            link.setAttribute('data-selected-language', activeCode);
            link.setAttribute('title', activeLabel + ' placement test');
        });

        Array.prototype.slice.call(document.querySelectorAll('[data-flw-practice-submenu-link]')).forEach(function(link) {
            var key = link.getAttribute('data-flw-practice-submenu-link');
            link.setAttribute('href', practiceUrls[key] || categoryUrls.practice);
            link.setAttribute('title', activeLabel + ' ' + link.textContent.trim() + ' practice');
        });

        Array.prototype.slice.call(document.querySelectorAll('[data-flw-exam-submenu-link]')).forEach(function(link) {
            var index = parseInt(link.getAttribute('data-flw-exam-submenu-link'), 10) - 1;
            var examLink = examLinks[index] || {};
            if (examLink.label) {
                link.textContent = examLink.label;
            }
            link.setAttribute('href', examLink.url || categoryUrls.exam);
            link.setAttribute('title', activeLabel + ' ' + (examLink.label || 'exam'));
            link.hidden = !examLink.label;
        });

        if (redirectCurrentCategory) {
            panel.classList.add('is-closed-after-select');
            closePanel();
            var currentCategoryType = panel.getAttribute('data-current-category-type');
            var targetUrl = categoryUrls[currentCategoryType] || '';
            if (targetUrl && normalizeUrl(targetUrl) !== normalizeUrl(window.location.href)) {
                window.location.href = targetUrl;
            }
        }
    }

    choices.forEach(function(choice) {
        choice.addEventListener('click', function() {
            applyLanguage(choice.getAttribute('data-language-code'), true);
        });
    });

    panel.addEventListener('mouseenter', openPanel);
    panel.addEventListener('mouseleave', function() {
        panel.classList.remove('is-closed-after-select');
        closePanel();
    });
    panel.addEventListener('focusin', function(event) {
        if (event.target === trigger) {
            panel.classList.remove('is-closed-after-select');
        }
        openPanel();
    });
    panel.addEventListener('focusout', function() {
        window.setTimeout(function() {
            if (!panel.contains(document.activeElement)) {
                closePanel();
            }
        }, 80);
    });

    if (trigger) {
        var dragState = null;
        var suppressClick = false;

        trigger.addEventListener('pointerdown', function(event) {
            if (event.button !== 0) {
                return;
            }
            var rect = panel.getBoundingClientRect();
            dragState = {
                pointerId: event.pointerId,
                startX: event.clientX,
                startY: event.clientY,
                startLeft: rect.left,
                startTop: rect.top,
                moved: false
            };
            if (trigger.setPointerCapture) {
                trigger.setPointerCapture(event.pointerId);
            }
        });

        trigger.addEventListener('pointermove', function(event) {
            if (!dragState || event.pointerId !== dragState.pointerId) {
                return;
            }
            var deltaX = event.clientX - dragState.startX;
            var deltaY = event.clientY - dragState.startY;
            if (!dragState.moved && Math.sqrt(deltaX * deltaX + deltaY * deltaY) < 5) {
                return;
            }
            dragState.moved = true;
            suppressClick = true;
            panel.classList.add('is-dragging', 'is-closed-after-select');
            closePanel();
            applyPanelPosition(dragState.startLeft + deltaX, dragState.startTop + deltaY);
            event.preventDefault();
        });

        trigger.addEventListener('pointerup', function(event) {
            if (!dragState || event.pointerId !== dragState.pointerId) {
                return;
            }
            if (trigger.releasePointerCapture) {
                try {
                    trigger.releasePointerCapture(event.pointerId);
                } catch (error) {
                    // The pointer may already be released by the browser.
                }
            }
            if (dragState.moved) {
                var rect = panel.getBoundingClientRect();
                var position = applyPanelPosition(rect.left, rect.top);
                storePosition(position.left, position.top);
                window.setTimeout(function() {
                    panel.classList.remove('is-dragging');
                    suppressClick = false;
                }, 80);
            }
            dragState = null;
        });

        trigger.addEventListener('pointercancel', function() {
            dragState = null;
            panel.classList.remove('is-dragging');
        });

        trigger.addEventListener('click', function() {
            if (suppressClick) {
                return;
            }
            var isOpen = panel.classList.contains('is-open') && !panel.classList.contains('is-closed-after-select');
            panel.classList.remove('is-closed-after-select');
            if (isOpen) {
                closePanel();
            } else {
                openPanel();
            }
        });
    }

    window.addEventListener('resize', function() {
        var rect = panel.getBoundingClientRect();
        var position = applyPanelPosition(rect.left, rect.top);
        storePosition(position.left, position.top);
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            panel.classList.add('is-closed-after-select');
            closePanel();
            if (trigger) {
                trigger.focus();
            }
        }
    });

    var saved = '';
    try {
        saved = window.localStorage.getItem(storageKey) || '';
    } catch (error) {
        saved = '';
    }
    var currentLanguage = panel.getAttribute('data-current-language-code') || '';
    applyLanguage(saved || readCookie(cookieKey) || currentLanguage || choices[0].getAttribute('data-language-code'), false);
    restorePanelPosition();
})();
{{/js}}
{{/haslearninglanguages}}
