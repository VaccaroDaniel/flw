{{!
    @template theme_flwacademy/frontpage

    FLW Academy redesigned Moodle front page.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block flw-frontpage-wrapper flw-redesign-page">
    {{{ output.standard_top_of_body_html }}}
    {{> theme_boost/navbar }}

    <style>
        .flw-start-page,.flw-start-page #page-wrapper{margin:0;background:#eef0f3;color:var(--flw-rd-text);font-family:Arial,Helvetica,sans-serif;line-height:1.35}
        .flw-redesign-page *{box-sizing:border-box}.flw-redesign-page a{color:inherit;text-decoration:none}.flw-redesign-page button,.flw-redesign-page input{font:inherit}.flw-redesign-page img,.flw-redesign-page svg{display:block;max-width:100%}
        .flw-redesign-home{width:min(1428px,calc(100vw - 20px));margin:58px auto 18px;padding:22px 0 22px;background:transparent;border:0;border-radius:0;box-shadow:none;overflow:visible;display:grid;gap:20px}
        .flw-logo{color:var(--flw-rd-blue);font-weight:900;letter-spacing:-2px;font-size:37px;line-height:1}.flw-primary-button,.flw-outline-button{height:46px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;padding:0 28px;font-size:15px;font-weight:700;border:1px solid transparent;cursor:pointer;white-space:nowrap}.flw-primary-button{background:var(--flw-rd-blue);color:#fff!important;box-shadow:0 3px 7px rgba(10,75,232,.18)}.flw-primary-button:hover{background:#073fca}.flw-outline-button{background:#fff;border-color:#6f93ee;color:var(--flw-rd-blue)!important}.flw-inline-placement-form{display:inline-flex;margin:0}.flw-hero-buttons .flw-inline-placement-form{width:170px}.flw-placement-copy .flw-inline-placement-form{width:100%}.flw-inline-placement-form .flw-primary-button,.flw-inline-placement-form .flw-outline-button{width:100%}
        .flw-home-header{height:65px;border-bottom:1px solid #e6e8ec;display:flex;align-items:center;padding:0 79px;background:#fff;position:relative;z-index:5}.flw-home-nav{margin-left:auto;display:flex;align-items:center;gap:46px;font-size:14px;font-weight:700;color:#11182c}.flw-home-nav a:not(.flw-sign-in):not(.flw-home-user-button):hover{color:var(--flw-rd-blue)}.flw-sign-in{border:1px solid #cbd2df;border-radius:8px;height:39px;min-width:100px;display:flex;align-items:center;justify-content:center}.flw-home-user-button{height:41px;max-width:185px;border:1px solid #d8dee9;border-radius:999px;background:#fff;box-shadow:0 1px 4px rgba(22,37,68,.04);display:flex;align-items:center;gap:9px;padding:0 12px 0 3px;color:#18213a;font-size:13px;font-weight:700}.flw-home-user-button .userpicture,.flw-home-user-button .userinitials,.flw-home-user-button .flw-home-avatar{width:34px!important;height:34px!important;border-radius:50%!important;object-fit:cover;overflow:hidden;flex:0 0 34px;display:grid;place-items:center}.flw-home-user-button span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.flw-mobile-menu-button{display:none;background:#fff;border:1px solid var(--flw-rd-line);border-radius:8px;width:40px;height:40px;font-size:20px;color:var(--flw-rd-text)}
        .flw-home-hero{min-height:302px;display:grid;grid-template-columns:44% 56%;overflow:hidden;background:#fff;border:1px solid #d8dbe1;border-radius:0;box-shadow:0 5px 20px rgba(31,43,68,.14)}.flw-hero-copy{padding:34px 0 28px 81px;position:relative;z-index:2}.flw-hero-copy h1{font-family:Georgia,"Times New Roman",serif;color:#091338;font-size:60px;line-height:1.02;letter-spacing:-2.2px;margin:0 0 16px;font-weight:700}.flw-hero-copy p{margin:0;color:#4b5d7b;font-size:17px;line-height:1.35}.flw-hero-buttons{display:flex;gap:17px;margin-top:20px}.flw-hero-buttons .flw-primary-button{width:189px}.flw-hero-buttons .flw-outline-button{width:170px}.flw-hero-reference{width:100%;height:302px;object-fit:cover;object-position:left top;border-radius:0}
        .flw-course-section{padding:22px 70px 24px;background:#fff;border:1px solid #d8dbe1;border-radius:11px;box-shadow:0 5px 20px rgba(31,43,68,.14)}.flw-home-block-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin:0 0 16px}.flw-home-block-head p{margin:0 0 5px;color:#0a4be8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0}.flw-home-block-head h2{margin:0;color:#101a3a;font-family:Georgia,"Times New Roman",serif;font-size:29px;font-weight:700;line-height:1.12}.flw-course-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:15px 14px}.flw-course-card{min-height:126px;background:#fff;border:1px solid #e2e4e9;border-radius:13px;box-shadow:var(--flw-rd-shadow-soft);display:grid;grid-template-columns:100px minmax(0,1fr);align-items:center;padding:8px 12px 8px 7px;overflow:visible}.flw-crest-frame{display:flex;align-items:center;justify-content:center;overflow:visible;padding:6px;width:96px;height:108px;flex-shrink:0}.flw-crest-image{display:block;width:100%;height:100%;object-fit:contain;object-position:center;flex-shrink:0}.flw-course-info{min-width:0;padding-left:2px}.flw-course-info h2{font-size:15px;font-weight:700;line-height:1.15;margin:0 0 4px;color:#10162b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.flw-course-info>p{font-size:13px;font-weight:400;margin:0 0 16px;color:#3d4b67}.flw-card-progress{height:3px;background:#e6e9ef;border-radius:6px;margin:0 0 5px;width:100%;overflow:hidden}.flw-card-progress i{display:block;height:100%;background:#2197e4;border-radius:6px}.flw-course-bottom{display:flex;align-items:center;justify-content:space-between;gap:7px;font-size:11px;color:#4a566d}.flw-course-metrics{min-width:0;display:grid;gap:1px}.flw-course-metrics span,.flw-course-metrics small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.flw-course-metrics small{color:#65718a;font-size:10px}.flw-course-bottom a{border:1px solid #5f8df2;border-radius:6px;color:var(--flw-rd-blue)!important;font-weight:700;padding:7px 10px;background:#fff}
        .flw-school-section{padding:22px 70px 26px;background:#fff;border:1px solid #d8dbe1;border-radius:11px;box-shadow:0 5px 20px rgba(31,43,68,.14)}.flw-school-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.flw-school-group{border:1px solid #e2e6ee;border-radius:13px;background:#fbfdff;padding:14px;min-width:0}.flw-school-group-head{display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:10px;margin-bottom:12px}.flw-school-group-head img{width:48px;height:54px;object-fit:contain}.flw-school-group-head h3{margin:0;color:#101a3a;font-size:16px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.flw-school-group-head a{font-size:11px;font-weight:700;color:var(--flw-rd-blue)!important}.flw-school-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.flw-school-card{min-height:92px;border:1px solid #e5e9f1;border-radius:10px;background:#fff;padding:10px;box-shadow:0 2px 8px rgba(23,39,79,.05);display:grid;gap:7px;color:#18213a}.flw-school-card:hover{border-color:#cbd8f5;box-shadow:0 6px 16px rgba(10,75,232,.08)}.flw-school-card strong{font-size:13px;line-height:1.15;color:#101a3a}.flw-school-card span{font-size:10px;color:#65718a}.flw-school-card small{font-size:10px;color:#101a3a}.flw-school-card .flw-card-progress{margin:0}
        .flw-how-section{display:grid;grid-template-columns:60% 40%;gap:23px;padding:24px 78px;background:#fff;border:1px solid #d8dbe1;border-radius:11px;box-shadow:0 5px 20px rgba(31,43,68,.14)}.flw-how-left h2{font:700 29px/1 Georgia,"Times New Roman",serif;margin:0 0 13px;color:#111a36}.flw-method-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.flw-method-card{min-height:161px;border:1px solid #e2e5ea;border-radius:12px;box-shadow:0 2px 8px rgba(24,40,75,.05);padding:11px 10px 10px;overflow:hidden}.flw-method-card.learn{background:#f3f8fd}.flw-method-card.practise{background:#f4f7ff}.flw-method-card.communicate{background:#f6f4fc}.flw-method-card.create{background:#fff8ef}.flw-method-card img{width:100%;height:65px;object-fit:cover;border-radius:7px;margin-bottom:4px}.flw-method-card h3{margin:0 0 2px;font-size:14px;color:#121929}.flw-method-card p{margin:0;font-size:11px;line-height:1.22;color:#233049}
        .flw-placement-panel{min-height:201px;border:1px solid #cbd8f5;border-radius:14px;background:linear-gradient(135deg,#fbfdff,#f2f7ff);display:grid;grid-template-columns:1fr 166px;align-items:center;padding:16px 18px 15px 25px;box-shadow:0 2px 8px rgba(32,57,104,.05)}.flw-placement-copy h2{font:700 26px/1.1 Georgia,"Times New Roman",serif;margin:0 0 9px;color:#111a36}.flw-placement-copy p{margin:0 0 13px;font-size:13px;color:#3f4e68;line-height:1.35}.flw-placement-copy .flw-primary-button,.flw-placement-copy .flw-outline-button{height:38px;margin-top:0;font-size:14px;width:100%}.flw-placement-copy .flw-outline-button{margin-top:7px}.flw-placement-panel img{width:146px;height:174px;object-fit:contain;justify-self:end}
        .flw-trust-strip{margin:0;min-height:99px;border:1px solid #dfe3ea;border-radius:11px;box-shadow:0 5px 20px rgba(31,43,68,.14);display:grid;grid-template-columns:repeat(4,1fr);background:#fff;overflow:hidden}.flw-trust-item{display:grid;grid-template-columns:58px 1fr;gap:13px;align-items:center;padding:13px 18px}.flw-trust-item+.flw-trust-item{border-left:1px solid #e5e8ee}.flw-trust-item strong{font-size:14px;color:#1d2840}.flw-trust-item p{font-size:11px;line-height:1.35;color:#516079;margin:4px 0 0}.flw-trust-icon{width:54px;height:54px;display:grid;place-items:center;color:currentColor}.flw-trust-icon svg{width:54px;height:54px;display:block;fill:currentColor}.flw-trust-icon.blue{color:#0e57dc}.flw-trust-icon.green{color:#327be1}.flw-trust-icon.purple{color:#8654cf}.flw-trust-icon.orange{color:#f68b00}
        .flw-demo-toast{position:fixed;left:50%;bottom:24px;z-index:100;transform:translate(-50%,20px);max-width:min(420px,calc(100vw - 32px));padding:11px 16px;border-radius:9px;background:#101a3a;color:#fff;font-size:13px;box-shadow:0 10px 30px rgba(10,20,50,.25);opacity:0;pointer-events:none;transition:opacity .2s ease,transform .2s ease}.flw-demo-toast.show{opacity:1;transform:translate(-50%,0)}.flw-page-blocks{padding:18px 22px;background:#fff;border:1px solid #d8dbe1;border-radius:11px;box-shadow:0 5px 20px rgba(31,43,68,.14)}.flw-page-blocks-add{display:flex;justify-content:flex-end;margin-bottom:12px}.flw-page-blocks .block{border:1px solid #e2e6ee;border-radius:10px;background:#fff;box-shadow:0 2px 8px rgba(23,39,79,.05);overflow:hidden}.flw-page-blocks .block+.block{margin-top:12px}.flw-page-blocks .card-title,.flw-page-blocks .block .card-title{font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:700;color:#111936}.flw-hidden-maincontent{display:none!important}
        .flw-home-nav a,.flw-primary-button,.flw-outline-button,.flw-course-bottom a,.flw-school-card,.flw-mobile-menu-button{outline:0;transition:background-color .16s ease,color .16s ease,border-color .16s ease,box-shadow .16s ease,transform .12s ease}.flw-home-nav a{display:inline-flex;align-items:center;justify-content:center}.flw-home-nav a:not(.flw-sign-in):not(.flw-home-user-button){border-radius:8px;padding:9px 10px;margin:-9px -10px}.flw-home-nav a:hover,.flw-home-nav a:focus-visible,.flw-outline-button:hover,.flw-outline-button:focus-visible,.flw-course-bottom a:hover,.flw-course-bottom a:focus-visible,.flw-mobile-menu-button:hover,.flw-mobile-menu-button:focus-visible{background:#f4f7ff;color:var(--flw-rd-blue)!important;border-color:#9db8ff;box-shadow:inset 0 0 0 1px #dbe6ff}.flw-primary-button:hover,.flw-primary-button:focus-visible{background:#073fca;color:#fff!important;box-shadow:0 6px 16px rgba(10,75,232,.18)}.flw-home-nav a:active,.flw-home-nav a.is-pressing,.flw-primary-button:active,.flw-primary-button.is-pressing,.flw-outline-button:active,.flw-outline-button.is-pressing,.flw-course-bottom a:active,.flw-course-bottom a.is-pressing,.flw-school-card:active,.flw-school-card.is-pressing,.flw-mobile-menu-button:active,.flw-mobile-menu-button.is-pressing{transform:translateY(1px) scale(.985);background:#eaf1ff;box-shadow:inset 0 0 0 1px #b8cbff}.flw-primary-button:active,.flw-primary-button.is-pressing{background:#073fca;color:#fff!important}.flw-course-card,.flw-method-card,.flw-trust-item{transition:border-color .16s ease,box-shadow .16s ease,transform .12s ease}.flw-course-card:hover,.flw-method-card:hover,.flw-trust-item:hover{border-color:#cbd8f5;box-shadow:0 6px 16px rgba(10,75,232,.08)}
        @media(max-width:1150px){.flw-home-header{padding:0 40px}.flw-home-nav{gap:25px}.flw-hero-copy{padding-left:40px}.flw-hero-copy h1{font-size:49px}.flw-course-section,.flw-school-section{padding-left:35px;padding-right:35px}.flw-school-groups{grid-template-columns:1fr}.flw-how-section{padding-left:40px;padding-right:40px;grid-template-columns:1fr}.flw-trust-strip{margin:0}}
        @media(max-width:1180px){html,body{overflow-y:auto!important}.flw-redesign-page{overflow-x:hidden;overflow-y:auto}.flw-redesign-home{height:auto!important;min-height:100vh!important;overflow:visible!important}.flw-home-hero{grid-template-columns:1fr!important;min-height:0!important;height:auto!important;overflow:visible!important}.flw-hero-copy{padding:38px 36px 28px!important}.flw-hero-copy h1{font-size:52px;letter-spacing:0}.flw-hero-reference{height:auto!important;max-height:360px!important;object-position:center top}.flw-course-section{padding:20px 34px 18px!important}.flw-course-grid{grid-template-columns:repeat(auto-fit,minmax(230px,1fr))!important}.flw-how-section{display:block!important;padding:22px 34px!important}.flw-method-grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))!important}.flw-placement-panel{margin-top:18px}.flw-trust-strip{height:auto!important;margin:0!important;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))!important;overflow:visible!important}.flw-trust-item{border-top:1px solid #e5e8ee}.flw-trust-item+.flw-trust-item{border-left:0!important}}
        @media(max-width:800px){.flw-redesign-home{width:calc(100% - 20px);margin:4px auto 8px;padding:16px 0 18px;border-radius:0;border:0;gap:14px}.flw-home-header{height:64px;padding:0 20px}.flw-home-nav{display:none;position:absolute;top:64px;left:12px;right:12px;background:#fff;border:1px solid var(--flw-rd-line);border-radius:12px;padding:14px;box-shadow:var(--flw-rd-shadow);flex-direction:column;align-items:stretch;gap:6px}.flw-home-nav.open{display:flex}.flw-home-nav a{padding:10px}.flw-mobile-menu-button{display:block;margin-left:auto}.flw-home-hero{height:auto;grid-template-columns:1fr}.flw-hero-copy{padding:42px 24px 30px}.flw-hero-copy h1{font-size:49px}.flw-hero-copy p br{display:none}.flw-hero-reference{height:auto;max-height:320px}.flw-course-section,.flw-school-section{padding:20px}.flw-home-block-head{display:block}.flw-home-block-head h2{font-size:25px}.flw-course-grid{grid-template-columns:1fr 1fr}.flw-school-grid{grid-template-columns:1fr 1fr}.flw-how-section{padding:20px;grid-template-columns:1fr}.flw-method-grid{grid-template-columns:1fr 1fr}.flw-placement-panel{grid-template-columns:1fr 120px}.flw-trust-strip{height:auto;margin:0;grid-template-columns:1fr 1fr}.flw-trust-item:nth-child(3){border-left:0;border-top:1px solid #e5e8ee}.flw-trust-item:nth-child(4){border-top:1px solid #e5e8ee}}
        @media(max-width:520px){.flw-course-grid,.flw-school-grid,.flw-method-grid,.flw-trust-strip{grid-template-columns:1fr}.flw-trust-item+.flw-trust-item{border-left:0;border-top:1px solid #e5e8ee}.flw-hero-copy h1{font-size:41px}.flw-hero-buttons{flex-direction:column}.flw-hero-buttons .flw-primary-button,.flw-hero-buttons .flw-outline-button{width:100%}.flw-placement-panel{grid-template-columns:1fr}.flw-placement-panel img{display:none}.flw-course-card{grid-template-columns:84px 1fr;min-height:106px;padding:9px 10px 9px 7px}.flw-crest-frame{width:80px;height:98px}.flw-course-info h2{font-size:13px}.flw-course-info>p{font-size:11px;margin-bottom:12px}.flw-course-bottom{font-size:10px}.flw-course-bottom a{padding:6px 9px}.flw-method-card{min-height:118px;display:grid;grid-template-columns:105px minmax(0,1fr);grid-template-rows:auto 1fr;gap:4px 10px;padding:12px;align-items:start}.flw-method-card img{grid-column:1;grid-row:1/3;width:105px;height:88px;object-fit:contain;margin:0;border-radius:8px;align-self:center}.flw-method-card h3{grid-column:2;grid-row:1;font-size:15px;margin-top:4px}.flw-method-card p{grid-column:2;grid-row:2;font-size:11px;line-height:1.35}.flw-trust-item{grid-template-columns:50px 1fr;padding:14px 13px;gap:11px}.flw-trust-icon,.flw-trust-icon svg{width:46px;height:46px}.flw-trust-item strong{font-size:13px}.flw-trust-item p{font-size:10px}}
        @media(prefers-reduced-motion:reduce){.flw-redesign-page *{scroll-behavior:auto!important;transition:none!important}}
    </style>

    <main id="page" data-region="mainpage" data-usertour="scroller" class="flw-redesign-home">
        <section class="flw-home-hero">
            <div class="flw-hero-copy">
                <h1>{{#str}}homeherotitle, theme_flwacademy{{/str}}</h1>
                <p>{{#str}}homeherolead, theme_flwacademy{{/str}}</p>
                <div class="flw-hero-buttons">
                    <a class="flw-primary-button" href="{{dashboardurl}}">{{#str}}continuelearning, theme_flwacademy{{/str}}</a>
                    {{#placementstartenabled}}
                    <form class="flw-inline-placement-form" method="post" action="{{placementstarturl}}">
                        <input type="hidden" name="cmid" value="{{placementcmid}}">
                        <input type="hidden" name="sesskey" value="{{placementsesskey}}">
                        <input type="hidden" name="flwautostart" value="1">
                        <input type="hidden" name="flwskippreflight" value="1">
                        <input type="hidden" name="flwplacement" value="1">
                        <input type="hidden" name="autostart" value="1">
                        <button class="flw-outline-button" type="submit">{{#str}}findmylevel, theme_flwacademy{{/str}}</button>
                    </form>
                    {{/placementstartenabled}}
                    {{^placementstartenabled}}
                    <a class="flw-outline-button" href="{{placementurl}}">{{#str}}findmylevel, theme_flwacademy{{/str}}</a>
                    {{/placementstartenabled}}
                </div>
            </div>
            <img class="flw-hero-reference" src="{{redesignheroimageurl}}" alt="{{#str}}homeheroimagealt, theme_flwacademy{{/str}}" decoding="async" fetchpriority="high">
        </section>

        <section class="flw-course-section" id="courses" aria-label="{{#str}}flwcourses, theme_flwacademy{{/str}}">
            <div class="flw-home-block-head">
                <div>
                    <p>{{#str}}languageworld, theme_flwacademy{{/str}}</p>
                    <h2>{{#str}}chooselanguageworld, theme_flwacademy{{/str}}</h2>
                </div>
            </div>
            <div class="flw-course-grid">
                {{#coursecards}}
                    <article class="flw-course-card">
                        <div class="flw-crest-frame">
                            <img class="flw-crest-image" src="{{cresturl}}" alt="{{alt}}" loading="lazy" decoding="async">
                        </div>
                        <div class="flw-course-info">
                            <h2>{{name}}</h2>
                            <p>{{range}}</p>
                            <div class="flw-card-progress"><i style="width:{{progress}}"></i></div>
                            <div class="flw-course-bottom"><span class="flw-course-metrics"><span>{{status}}</span><small>{{progresslabel}}</small></span><a href="{{url}}">{{#str}}continue, theme_flwacademy{{/str}}</a></div>
                        </div>
                    </article>
                {{/coursecards}}
            </div>
        </section>

        {{#hasschoolgroups}}
        <section class="flw-school-section" id="k12" aria-label="{{#str}}flwk12categories, theme_flwacademy{{/str}}">
            <div class="flw-home-block-head">
                <div>
                    <p>{{#str}}k12, theme_flwacademy{{/str}}</p>
                    <h2>{{#str}}schoolcoursecategories, theme_flwacademy{{/str}}</h2>
                </div>
            </div>
            <div class="flw-school-groups">
                {{#schoolgroups}}
                <article class="flw-school-group">
                    <div class="flw-school-group-head">
                        <img src="{{cresturl}}" alt="{{worldname}} {{#str}}crest, theme_flwacademy{{/str}}" loading="lazy" decoding="async">
                        <h3>{{name}}</h3>
                        <a href="{{url}}">{{#str}}open, theme_flwacademy{{/str}}</a>
                    </div>
                    <div class="flw-school-grid">
                        {{#cards}}
                        <a class="flw-school-card" href="{{url}}">
                            <strong>{{shortname}}</strong>
                            <span>{{coursecountlabel}}</span>
                            <div class="flw-card-progress"><i style="width:{{progress}}"></i></div>
                            <small>{{progresslabel}}</small>
                        </a>
                        {{/cards}}
                    </div>
                </article>
                {{/schoolgroups}}
            </div>
        </section>
        {{/hasschoolgroups}}

        <section class="flw-how-section" id="how">
            <div class="flw-how-left">
                <h2>{{#str}}howflwworks, theme_flwacademy{{/str}}</h2>
                <div class="flw-method-grid">
                    <article class="flw-method-card learn"><img src="{{howlearnimageurl}}" alt="{{#str}}learn, theme_flwacademy{{/str}}" loading="lazy" decoding="async"><h3>{{#str}}learn, theme_flwacademy{{/str}}</h3><p>{{#str}}learntext, theme_flwacademy{{/str}}</p></article>
