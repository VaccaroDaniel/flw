{{!
    @template theme_flwacademy/frontpage

    FLW Academy Moodle front page.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block flw-frontpage-wrapper">
    {{{ output.standard_top_of_body_html }}}
    {{> theme_boost/navbar }}
    <style>
        :root{--flw-font-body:Inter,"Segoe UI",Arial,sans-serif;--flw-font-heading:Inter,"Segoe UI",Arial,sans-serif;--flw-font-serif:Georgia,"Times New Roman","Noto Serif","Noto Serif CJK SC","Noto Serif CJK JP","Noto Serif CJK KR",serif}.flw-start-page,.flw-start-page button,.flw-start-page input,.flw-start-page select,.flw-start-page textarea{font-family:var(--flw-font-body)}.flw-start-page h1,.flw-start-page h2,.flw-start-page h3,.flw-frontpage{font-family:var(--flw-font-heading)}.flw-start-page,.flw-start-page #page-wrapper{background:#f7faf8}.flw-frontpage{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:5.5rem 0 3.5rem;color:#17242a}.flw-frontpage a{text-decoration:none}.flw-start-hero{position:relative;min-height:470px;display:grid;grid-template-columns:minmax(0,1fr) minmax(310px,360px);gap:1.5rem;align-items:center;overflow:hidden;border:1px solid #d8e3df;border-radius:.75rem;background:#fff;box-shadow:0 12px 30px rgba(23,36,42,.09)}.flw-start-hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(255,255,255,.92),rgba(255,255,255,.18))}.flw-start-hero-art{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center 58%}.flw-start-copy,.flw-start-access{position:relative;z-index:2}.flw-start-copy{max-width:720px;padding:2.25rem}.flw-kicker{margin:0 0 .5rem;color:#075a64;font-size:.82rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.flw-start-copy h1{max-width:11ch;margin:0;color:#17242a;font-size:clamp(2.45rem,5vw,4.45rem);font-weight:900;letter-spacing:0;line-height:.98}.flw-start-access h2,.flw-section-heading h2{margin:0;color:#17242a;font-weight:900;letter-spacing:0}.flw-lead{max-width:42rem;margin:1rem 0 0;color:#5d6b72;font-size:1.15rem;line-height:1.6}.flw-start-metrics,.flw-start-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.1rem}.flw-start-metrics span{display:inline-flex;min-height:2.5rem;align-items:center;gap:.4rem;padding:.5rem .65rem;border:1px solid rgba(8,127,140,.22);border-radius:.5rem;background:rgba(255,255,255,.88);color:#5d6b72;font-size:.82rem;font-weight:800}.flw-start-metrics strong{color:#075a64;font-size:1.12rem}.flw-start-button{min-height:2.75rem;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.65rem .95rem;border:1px solid #d8e3df;border-radius:.5rem;background:#fff;color:#17242a!important;font-weight:900}.flw-start-button-primary{border-color:#087f8c;background:#087f8c;color:#fff!important}.flw-start-button-small{min-height:2.25rem;padding:.45rem .7rem;font-size:.88rem}.flw-full{width:100%}.flw-start-access{display:grid;gap:.9rem;align-content:start;margin-right:1.5rem;padding:1.25rem;border:1px solid #d8e3df;border-radius:.5rem;background:rgba(255,255,255,.92);box-shadow:0 10px 24px rgba(23,36,42,.10)}.flw-start-access h2{font-size:1.5rem;line-height:1.18}.flw-start-access ul{display:grid;gap:.65rem;margin:0;padding:0;list-style:none}.flw-start-access li{display:grid;gap:.15rem;padding:.65rem;border:1px solid #d8e3df;border-radius:.5rem;background:#f0f6f4}.flw-start-access li span{color:#5d6b72;font-size:.82rem;font-weight:650}.flw-route-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin:1.35rem 0}.flw-route-strip a{display:grid;min-height:8.25rem;align-content:start;gap:.35rem;padding:1.1rem;border:1px solid #d8e3df;border-top:5px solid #087f8c;border-radius:.5rem;background:#fff;color:#17242a!important;box-shadow:0 8px 18px rgba(23,36,42,.06)}.flw-route-strip a:nth-child(2){border-top-color:#e85d4f}.flw-route-strip a:nth-child(3){border-top-color:#4f9d54}.flw-route-strip span{color:#075a64;font-size:.82rem;font-weight:900}.flw-route-strip strong{font-size:1.18rem}.flw-route-strip small{color:#5d6b72;font-size:.82rem;line-height:1.45}.flw-front-band{margin-top:1.35rem;padding:1.5rem;border:1px solid #d8e3df;border-radius:.5rem;background:#fff;box-shadow:0 12px 30px rgba(23,36,42,.09)}.flw-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:.9rem}.flw-section-heading h2{font-size:clamp(1.65rem,3vw,2.25rem)}.flw-language-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.9rem}.flw-language-card{display:grid;min-height:15.6rem;align-content:start;gap:.55rem;padding:1.1rem;border:1px solid #d8e3df;border-top:5px solid #087f8c;border-radius:.5rem;background:#fff;color:#17242a!important}.flw-language-card:first-child{grid-column:span 2}.flw-language-card img{width:100%;aspect-ratio:16/8.5;display:block;border-radius:.5rem;object-fit:cover;background:#f0f6f4}.flw-language-card span{width:fit-content;min-height:1.75rem;display:inline-flex;align-items:center;padding:.3rem .55rem;border-radius:.5rem;background:#f0f6f4;color:#075a64;font-size:.75rem;font-weight:900}.flw-language-card h3{margin:0;color:#17242a;font-size:1.38rem;font-weight:900}.flw-language-card p{margin:0;color:#5d6b72}.flw-language-card .flw-native{color:#17242a;font-weight:850}.flw-language-coral{border-top-color:#e85d4f}.flw-language-yellow{border-top-color:#f2b84b}.flw-language-green{border-top-color:#4f9d54}.flw-language-blue{border-top-color:#3278bd}.flw-daily-grid,.flw-news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.9rem}.flw-daily-grid article,.flw-news-grid article{min-height:11rem;padding:1rem;border:1px solid #d8e3df;border-top:5px solid #3278bd;border-radius:.5rem;background:#fff}.flw-news-grid article:nth-child(2){border-top-color:#f2b84b}.flw-news-grid article:nth-child(3){border-top-color:#e85d4f}.flw-daily-grid span,.flw-news-grid span{color:#075a64;font-size:.78rem;font-weight:900;text-transform:uppercase}.flw-daily-grid h3,.flw-news-grid h3{margin:.45rem 0;color:#17242a;font-size:1.25rem;font-weight:900}.flw-daily-grid p,.flw-news-grid p{margin:0;color:#5d6b72}@media(max-width:920px){.flw-start-hero,.flw-route-strip,.flw-language-grid,.flw-daily-grid,.flw-news-grid{grid-template-columns:1fr}.flw-language-card:first-child{grid-column:auto}.flw-start-access{margin:0 1.1rem 1.1rem}}@media(max-width:620px){.flw-frontpage{width:min(100% - 22px,1180px);padding-top:4.8rem}.flw-start-copy,.flw-front-band{padding:1rem}.flw-start-copy h1{font-size:2.1rem}.flw-section-heading{align-items:flex-start;flex-direction:column}.flw-start-metrics span{width:100%}}
    </style>
    <style>
        .flw-frontpage{padding-top:5.5rem}
        .flw-start-copy h1{max-width:780px;font-size:42px;font-weight:900;line-height:1.08}
        .flw-start-access h2{font-size:24px;font-weight:700;line-height:1.18}
        .flw-tips-grid,.flw-users-grid,.flw-faq-grid{display:grid;gap:.9rem}
        .flw-tips-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
        .flw-users-grid{grid-template-columns:repeat(5,minmax(0,1fr))}
        .flw-tip-card,.flw-user-card,.flw-faq-grid details{padding:1rem;border:1px solid #d8e3df;border-top:5px solid #087f8c;border-radius:.5rem;background:#fff}
        .flw-tip-card:nth-child(2),.flw-user-card:nth-child(2){border-top-color:#3278bd}.flw-tip-card:nth-child(3),.flw-user-card:nth-child(3){border-top-color:#e85d4f}.flw-user-card:nth-child(4){border-top-color:#4f9d54}.flw-user-card:nth-child(5){border-top-color:#f2b84b}
        .flw-tip-card span,.flw-user-card span{color:#075a64;font-size:.78rem;font-weight:900;text-transform:uppercase}
        .flw-tip-card h3,.flw-user-card h3{margin:.45rem 0;color:#17242a;font-size:1.15rem;font-weight:900}
        .flw-tip-card p,.flw-user-card p,.flw-faq-grid p{margin:0;color:#5d6b72}
        .flw-user-card strong{display:block;color:#17242a;font-size:1.35rem}
        .flw-faq-grid summary{cursor:pointer;color:#17242a;font-weight:900}
        .flw-hidden-maincontent{display:none!important}
        .flw-start-page .flw-kicker,.flw-start-page .flw-start-copy h1,.flw-start-page .flw-section-heading h2,.flw-start-page .flw-start-access h2,.flw-start-page .flw-start-button,.flw-start-page .flw-route-strip strong,.flw-start-page .flw-language-card h3,.flw-start-page .flw-daily-grid h3,.flw-start-page .flw-news-grid h3,.flw-start-page .flw-tip-card h3,.flw-start-page .flw-user-card h3,.flw-start-page .flw-faq-grid summary{font-weight:700!important}
        .flw-start-page .flw-section-heading h2{font-size:26px!important;line-height:1.18}
        .flw-start-page .flw-start-metrics span,.flw-start-page .flw-start-metrics strong,.flw-start-page .flw-route-strip span,.flw-start-page .flw-language-card span,.flw-start-page .flw-language-card .flw-native,.flw-start-page .flw-daily-grid span,.flw-start-page .flw-news-grid span,.flw-start-page .flw-tip-card span,.flw-start-page .flw-user-card span,.flw-start-page .flw-user-card strong,.flw-start-page .flw-start-access li strong{font-weight:650!important}
        @media(max-width:920px){.flw-tips-grid,.flw-users-grid{grid-template-columns:1fr 1fr}}
        @media(max-width:620px){.flw-start-copy h1{font-size:32px}.flw-start-access h2{font-size:20px}.flw-tips-grid,.flw-users-grid{grid-template-columns:1fr}}
    </style>

    <main id="page" data-region="mainpage" data-usertour="scroller" class="flw-frontpage">
        <section class="flw-start-hero">
            <img class="flw-start-hero-art" src="{{heroimageurl}}" alt="">
            <div class="flw-start-copy">
                <p class="flw-kicker">{{copy.brand}}</p>
                <h1>{{copy.herotitle}}</h1>
                <p class="flw-lead">{{copy.herolead}}</p>
                <div class="flw-start-metrics" aria-label="{{copy.metricsaria}}">
                    <span><strong>7</strong> {{copy.metriclanguages}}</span>
                    <span><strong>120</strong> {{copy.metricplacement}}</span>
                    <span><strong>365</strong> {{copy.metricmottos}}</span>
                </div>
                <div class="flw-start-actions">
                    <a class="flw-start-button flw-start-button-primary" href="{{loginurl}}">{{copy.startplacement}}</a>
                    <a class="flw-start-button" href="{{courseindexurl}}">{{copy.browsecoursemap}}</a>
                    <a class="flw-start-button" href="{{dashboardurl}}">{{copy.enterdashboard}}</a>
                </div>
            </div>
            <aside class="flw-start-access">
                <p class="flw-kicker">{{copy.accesskicker}}</p>
                <h2>{{copy.accesstitle}}</h2>
                <ul>
                    <li><strong>{{copy.learnerstitle}}</strong><span>{{copy.learnersdesc}}</span></li>
                    <li><strong>{{copy.teacherstitle}}</strong><span>{{copy.teachersdesc}}</span></li>
                    <li><strong>{{copy.schoolstitle}}</strong><span>{{copy.schoolsdesc}}</span></li>
                </ul>
                <a class="flw-start-button flw-start-button-primary flw-full" href="{{loginurl}}">{{copy.loginflw}}</a>
                <a class="flw-start-button flw-full" href="#flw-daily">{{copy.previewdaily}}</a>
            </aside>
        </section>

        <section id="flw-path" class="flw-route-strip" aria-label="{{copy.patharia}}">
            <a href="{{loginurl}}">
                <span>01</span>
                <strong>{{copy.route1title}}</strong>
                <small>{{copy.route1text}}</small>
            </a>
            <a href="{{courseindexurl}}">
                <span>02</span>
                <strong>{{copy.route2title}}</strong>
                <small>{{copy.route2text}}</small>
            </a>
            <a href="{{dashboardurl}}">
                <span>03</span>
                <strong>{{copy.route3title}}</strong>
                <small>{{copy.route3text}}</small>
            </a>
        </section>

        <section id="flw-categories" class="flw-front-band">
            <div class="flw-section-heading">
                <div>
                    <p class="flw-kicker">{{copy.categorieskicker}}</p>
                    <h2>{{copy.categoriestitle}}</h2>
                </div>
                <a class="flw-start-button flw-start-button-small" href="{{courseindexurl}}">{{copy.viewalllanguages}}</a>
            </div>
            <div class="flw-language-grid">
                {{#languages}}
                    <a class="flw-language-card flw-language-{{accent}}" href="{{url}}">
                        <img src="{{imageurl}}" alt="{{name}} {{copy.languagealt}}">
                        <span>{{framework}}</span>
                        <h3>{{name}}</h3>
                        <p class="flw-native">{{native}}</p>
                        <p>{{motto}}</p>
                    </a>
                {{/languages}}
            </div>
        </section>

        <section id="flw-daily" class="flw-front-band">
            <div class="flw-section-heading">
                <div>
                    <p class="flw-kicker">{{copy.dailykicker}}</p>
                    <h2>{{copy.dailytitle}}</h2>
                </div>
            </div>
            <div class="flw-daily-grid">
                <article>
                    <span>{{copy.dailywordlabel}}</span>
                    <h3>{{copy.dailyword}}</h3>
                    <p>{{copy.dailywordtext}}</p>
                </article>
                <article>
                    <span>{{copy.dailysentencelabel}}</span>
                    <h3>{{copy.dailysentence}}</h3>
                    <p>{{copy.dailysentencetext}}</p>
                </article>
                <article>
                    <span>{{copy.todaylabel}}</span>
                    <h3>{{copy.todaytitle}}</h3>
                    <p>{{copy.todaytext}}</p>
                </article>
            </div>
        </section>

        <section id="flw-news" class="flw-front-band">
            <div class="flw-section-heading">
                <div>
                    <p class="flw-kicker">{{copy.newskicker}}</p>
                    <h2>{{copy.newstitle}}</h2>
                </div>
            </div>
            <div class="flw-news-grid">
                <article>
                    <span>{{copy.news1meta}}</span>
                    <h3>{{copy.news1title}}</h3>
                    <p>{{copy.news1text}}</p>
                </article>
                <article>
                    <span>{{copy.news2meta}}</span>
                    <h3>{{copy.news2title}}</h3>
                    <p>{{copy.news2text}}</p>
                </article>
                <article>
                    <span>{{copy.news3meta}}</span>
                    <h3>{{copy.news3title}}</h3>
                    <p>{{copy.news3text}}</p>
                </article>
            </div>
        </section>

        <section id="flw-tips" class="flw-front-band">
            <div class="flw-section-heading">
                <div>
                    <p class="flw-kicker">{{copy.tipskicker}}</p>
                    <h2>{{copy.tipstitle}}</h2>
                </div>
            </div>
            <div class="flw-tips-grid">
                <article class="flw-tip-card">
                    <span>{{copy.tip1meta}}</span>
                    <h3>{{copy.tip1title}}</h3>
                    <p>{{copy.tip1text}}</p>
                </article>
                <article class="flw-tip-card">
                    <span>{{copy.tip2meta}}</span>
                    <h3>{{copy.tip2title}}</h3>
                    <p>{{copy.tip2text}}</p>
                </article>
                <article class="flw-tip-card">
                    <span>{{copy.tip3meta}}</span>
                    <h3>{{copy.tip3title}}</h3>
                    <p>{{copy.tip3text}}</p>
                </article>
            </div>
        </section>

        <section id="flw-users" class="flw-front-band">
            <div class="flw-section-heading">
                <div>
                    <p class="flw-kicker">{{copy.userskicker}}</p>
                    <h2>{{copy.userstitle}}</h2>
                </div>
            </div>
            <div class="flw-users-grid">
                <article class="flw-user-card"><span>English | B1</span><h3>Mina</h3><strong>18 h</strong><p>{{copy.listeningstreak}}</p></article>
                <article class="flw-user-card"><span>Chinese | HSK 3</span><h3>Alex</h3><strong>15 h</strong><p>{{copy.speakingroom}}</p></article>
                <article class="flw-user-card"><span>French | A2</span><h3>Sofia</h3><strong>12 h</strong><p>{{copy.readingnotes}}</p></article>
                <article class="flw-user-card"><span>German | B2</span><h3>Daniel</h3><strong>21 h</strong><p>{{copy.exampractice}}</p></article>
                <article class="flw-user-card"><span>Spanish | A1</span><h3>Yuki</h3><strong>10 h</strong><p>{{copy.dailysentencebrief}}</p></article>
            </div>
        </section>

        <section id="flw-faq" class="flw-front-band">
            <div class="flw-section-heading">
                <div>
                    <p class="flw-kicker">{{copy.faqkicker}}</p>
                    <h2>{{copy.faqtitle}}</h2>
                </div>
            </div>
            <div class="flw-faq-grid">
                <details><summary>{{copy.faq1q}}</summary><p>{{copy.faq1a}}</p></details>
                <details><summary>{{copy.faq2q}}</summary><p>{{copy.faq2a}}</p></details>
                <details><summary>{{copy.faq3q}}</summary><p>{{copy.faq3a}}</p></details>
                <details><summary>{{copy.faq4q}}</summary><p>{{copy.faq4a}}</p></details>
            </div>
        </section>
        <div class="flw-hidden-maincontent" hidden aria-hidden="true">{{{maincontent}}}</div>
    </main>

    {{{ output.standard_after_main_region_html }}}
</div>
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
