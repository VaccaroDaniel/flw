{{#js}}
(function() {
    function bindPressEffect(root, selector) {
        root.querySelectorAll(selector).forEach(function(control) {
            control.addEventListener('pointerdown', function() {
                control.classList.add('is-pressing');
            });
            ['pointerup', 'pointercancel', 'mouseleave', 'blur'].forEach(function(eventname) {
                control.addEventListener(eventname, function() {
                    control.classList.remove('is-pressing');
                });
            });
        });
    }
    bindPressEffect(document, '.flw-home-nav a,.flw-primary-button,.flw-outline-button,.flw-course-bottom a,.flw-school-card,.flw-mobile-menu-button');
    var button = document.querySelector('[data-flw-mobile-menu]');
    var nav = document.querySelector('[data-flw-home-nav]');
    if (button && nav) {
        nav.id = 'flw-home-nav';
        button.addEventListener('click', function(event) {
            event.stopPropagation();
            var open = !nav.classList.contains('open');
            nav.classList.toggle('open', open);
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        nav.querySelectorAll('a').forEach(function(link) {
            link.addEventListener('click', function() {
                nav.classList.remove('open');
                button.setAttribute('aria-expanded', 'false');
            });
        });
    }
    var toast = document.querySelector('[data-flw-toast]');
    var timer;
    document.querySelectorAll('[data-flw-demo-message]').forEach(function(control) {
        control.addEventListener('click', function() {
            if (!toast) {
                return;
            }
            toast.textContent = control.getAttribute('data-flw-demo-message') || 'This action is ready to connect.';
            toast.classList.add('show');
            window.clearTimeout(timer);
            timer = window.setTimeout(function() {
                toast.classList.remove('show');
            }, 2400);
        });
    });
})();
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
