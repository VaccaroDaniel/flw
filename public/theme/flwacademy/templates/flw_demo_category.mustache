{{!
    @template theme_flwacademy/flw_demo_category

    FLW Demo category page.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block flw-selfstudy-wrapper flw-demo-wrapper">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}
    {{> theme_flwacademy/flw_tools_group }}

    <style>
        :root{--flw-bg:#f7f9fd;--flw-surface:#fff;--flw-surface-strong:#f7f9fd;--flw-ink:#111936;--flw-muted:#5f6d8d;--flw-line:#dbe6ff;--flw-teal:#0a4be8;--flw-teal-dark:#082a84;--flw-coral:#e85d4f;--flw-green:#327be1;--flw-yellow:#f2b84b;--flw-blue:#3278bd;--flw-radius:8px;--flw-shadow:0 12px 30px rgba(23,36,42,.09)}
        .flw-school-category-page{margin:0;background:var(--flw-bg);color:var(--flw-ink);font-family:Inter,"Segoe UI",Arial,sans-serif;line-height:1.5}
        .flw-page-shell{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:86px 0 56px}.flw-stack{display:grid;gap:18px}
        .flw-band,.flw-card{border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:var(--flw-surface);box-shadow:var(--flw-shadow);color:var(--flw-ink)!important}.flw-band-inner{padding:18px}
        .flw-sub-banner{position:relative;min-height:340px;display:grid;align-items:center;overflow:hidden;padding:32px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:#fff;box-shadow:var(--flw-shadow)}.flw-sub-banner:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(255,255,255,.72),rgba(255,255,255,.06))}.flw-sub-banner img{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center 58%}.flw-sub-banner>div{position:relative;z-index:2;max-width:820px}
        .flw-page-kicker{margin:0 0 8px;color:var(--flw-teal-dark)!important;font-size:13px;font-weight:800;text-transform:uppercase}.flw-sub-banner h1{margin:0 0 10px;color:#101a3a;font-size:42px;line-height:1.05;font-weight:700;text-shadow:0 2px 12px rgba(255,255,255,.58)}.flw-sub-banner p:not(.flw-page-kicker){max-width:760px;margin:0;color:#334a7d;font-size:19px;line-height:1.5;text-shadow:0 2px 10px rgba(255,255,255,.62)}
        .flw-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:10px}.flw-section-heading h2,.flw-card h2{margin:0 0 8px;color:var(--flw-ink);font-size:24px;line-height:1.15;font-weight:700}.flw-card h3{margin:0 0 6px;color:var(--flw-ink);font-size:17px;line-height:1.2;font-weight:700}.flw-muted{color:var(--flw-muted)!important}
        .flw-card{min-width:0;padding:14px;color:var(--flw-ink)!important}.flw-card p:not(.flw-muted):not(.flw-page-kicker),.flw-card li,.flw-card small,.flw-band p:not(.flw-muted):not(.flw-page-kicker),.flw-band li{color:var(--flw-ink)!important}.flw-card.accent-teal{border-top:4px solid var(--flw-teal)}.flw-card.accent-coral{border-top:4px solid var(--flw-coral)}.flw-card.accent-green{border-top:4px solid var(--flw-green)}.flw-card.accent-yellow{border-top:4px solid var(--flw-yellow)}.flw-card.accent-blue{border-top:4px solid var(--flw-blue)}
        .flw-demo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.flw-demo-info{display:grid;gap:6px;align-content:start;min-height:104px}
        .flw-metric-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:4px}.flw-metric{min-height:52px;padding:8px;border:1px solid var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.86)}.flw-metric strong{display:block;color:var(--flw-teal-dark);font-size:18px;line-height:1}.flw-metric span{color:var(--flw-muted);font-size:11px}
        .flw-course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.flw-course-card{display:grid;gap:7px;align-content:start;overflow:hidden;padding:9px;text-decoration:none!important}.flw-course-cover{width:100%;aspect-ratio:16/8.2;display:block;border-radius:calc(var(--flw-radius) - 2px);object-fit:cover;background:var(--flw-surface-strong)}.flw-course-meta{color:var(--flw-teal-dark)!important;font-size:11px;font-weight:800;text-transform:uppercase}.flw-course-card h3{margin-bottom:0}.flw-empty{padding:14px;border:1px dashed var(--flw-line);border-radius:var(--flw-radius);background:rgba(255,255,255,.7);color:var(--flw-muted)}.flw-hidden-maincontent{display:none!important}
        .flw-school-category-page{background:#eef0f3;color:#111936;font-family:Arial,Helvetica,sans-serif;line-height:1.35}
        .flw-page-shell{width:min(1428px,calc(100% - 20px));padding:84px 0 56px}
        .flw-band,.flw-card{border-color:#e5e8ef;border-radius:12px;background:#fff;box-shadow:0 4px 14px rgba(23,39,79,.10)}
        .flw-sub-banner{border-color:#e5e8ef;border-radius:12px;box-shadow:0 4px 14px rgba(23,39,79,.10)}
        .flw-page-kicker,.flw-course-meta{color:#082a84!important;font-size:13px;font-weight:700}
        .flw-sub-banner h1,.flw-section-heading h2,.flw-card h2{font-family:Georgia,"Times New Roman",serif;color:#101a3a;font-weight:700}
        .flw-sub-banner h1{font-size:42px;line-height:1.08;letter-spacing:-1.4px}
        .flw-section-heading h2,.flw-card h2{font-size:26px;line-height:1.15}
        .flw-card h3{color:#10162b;font-size:18px;font-weight:700}
        .flw-sub-banner p:not(.flw-page-kicker),.flw-muted,.flw-card p,.flw-band p{color:#5f6d8d!important;font-size:12px;line-height:1.3}
        .flw-card.accent-teal,.flw-course-card{border-top-color:#0a4be8}.flw-card.accent-blue{border-top-color:#327be1}.flw-card.accent-yellow{border-top-color:#f38a00}
        @media(max-width:980px){.flw-demo-grid,.flw-course-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
        @media(max-width:640px){.flw-page-shell{width:min(100% - 22px,1180px);padding-top:76px}.flw-sub-banner,.flw-band-inner{padding:16px}.flw-demo-grid,.flw-course-grid,.flw-metric-strip{grid-template-columns:1fr}}
    </style>

    <main id="page" class="flw-page-shell flw-stack">
        <section class="flw-sub-banner">
            <img src="{{heroimageurl}}" alt="">
            <div>
                <p class="flw-page-kicker">Demo</p>
                <h1>Try FLW learning experiences.</h1>
                {{#hasdescription}}{{{description}}}{{/hasdescription}}
                {{^hasdescription}}<p>Open a sample course, explore activity flows, and preview how FLW feels before entering a full learning path.</p>{{/hasdescription}}
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-demo-grid">
                    <article class="flw-card accent-teal flw-demo-info">
                        <p class="flw-page-kicker">Preview</p>
                        <h2>Course-like browsing</h2>
                        <p class="flw-muted">Use the same calm reader-style cards and course covers from Self Study.</p>
                    </article>
                    <article class="flw-card accent-yellow flw-demo-info">
                        <p class="flw-page-kicker">Materials</p>
                        <h2>Sample activities</h2>
                        <p class="flw-muted">Open demo content without changing the core Moodle permissions or course structure.</p>
                    </article>
                    <article class="flw-card accent-blue flw-demo-info">
                        <p class="flw-page-kicker">Available</p>
                        <h2>{{coursecount}} courses</h2>
                        <div class="flw-metric-strip">
                            <div class="flw-metric"><strong>{{coursecount}}</strong><span>Visible</span></div>
                            <div class="flw-metric"><strong>FLW</strong><span>Theme</span></div>
                            <div class="flw-metric"><strong>Demo</strong><span>Mode</span></div>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="flw-band">
            <div class="flw-band-inner">
                <div class="flw-section-heading"><div><p class="flw-page-kicker">Courses</p><h2>Demo Courses</h2></div></div>
                {{#hascourses}}
                <div class="flw-course-grid">
                    {{#courses}}
                    <a class="flw-card flw-course-card accent-teal" href="{{url}}">
                        <img class="flw-course-cover" src="{{imageurl}}" alt="">
                        <span class="flw-course-meta">{{categoryname}}</span>
                        <h3>{{name}}</h3>
                        {{#summary}}<p class="flw-muted">{{summary}}</p>{{/summary}}
                    </a>
                    {{/courses}}
                </div>
                {{/hascourses}}
                {{^hascourses}}<div class="flw-empty">No demo courses have been added yet.</div>{{/hascourses}}
            </div>
        </section>

        <div class="flw-hidden-maincontent">{{{maincontent}}}</div>
    </main>
</div>
{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
