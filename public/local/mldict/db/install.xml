<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/mldict/db" VERSION="2026061000" COMMENT="XMLDB file for local_mldict"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_mldict_entry" COMMENT="Multilingual dictionary headword entries">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="headword" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourcelang" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" DEFAULT="en"/>
        <FIELD NAME="partofspeech" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="cefrlevel" TYPE="char" LENGTH="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="pronunciation" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="phonetic" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="definition" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="notes" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="headwordlang" UNIQUE="false" FIELDS="headword, sourcelang"/>
        <INDEX NAME="sourcelang_headword" UNIQUE="false" FIELDS="sourcelang, headword"/>
        <INDEX NAME="sourcelang" UNIQUE="false" FIELDS="sourcelang"/>
        <INDEX NAME="cefrlevel" UNIQUE="false" FIELDS="cefrlevel"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_mldict_translation" COMMENT="Translations for dictionary entries">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="entryid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="targetlang" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="translation" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="definition" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="entryid" TYPE="foreign" FIELDS="entryid" REFTABLE="local_mldict_entry" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="entrytarget" UNIQUE="false" FIELDS="entryid, targetlang"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_mldict_example" COMMENT="Example sentences for dictionary entries">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="entryid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="examplelang" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sentence" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="translation" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="entryid" TYPE="foreign" FIELDS="entryid" REFTABLE="local_mldict_entry" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="entrylang" UNIQUE="false" FIELDS="entryid, examplelang"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
