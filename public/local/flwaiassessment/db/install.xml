<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/flwaiassessment/db" VERSION="2026061200" COMMENT="XMLDB file for FLW AI Assessment"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_flwai_results" COMMENT="Offline AI assessment estimates and teacher confirmations for FLW">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="activitytype" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourcecomponent" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="submissionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="skilltype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="writing" SEQUENCE="false"/>
        <FIELD NAME="rawtext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="transcript" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="audiopath" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="prompttext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false"/>
        <FIELD NAME="cefrlevel" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="totalscore" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="rubricjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="weakkpjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="recommendjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="airesponsejson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="error" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="teachercefrlevel" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="teacherscore" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="teachernote" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="teacherconfirmed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="confirmedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeconfirmed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="skill-status" UNIQUE="false" FIELDS="skilltype, status"/>
        <INDEX NAME="submission" UNIQUE="false" FIELDS="sourcecomponent, submissionid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
