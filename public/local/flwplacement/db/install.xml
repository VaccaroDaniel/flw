<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/flwplacement/db" VERSION="2026070200" COMMENT="XMLDB file for FLW Placement"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_flwplacement" COMMENT="FLW adaptive placement attempts and reports">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cefrlevel" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="recommendedcourse" TYPE="char" LENGTH="80" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="startingunit" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="confidencescore" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="weightedscore" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="skillprofilejson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="skillpercentjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="weakskillsjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="resultjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="attemptjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="course-user-time" UNIQUE="false" FIELDS="courseid, userid, timecreated"/>
        <INDEX NAME="cefrlevel" UNIQUE="false" FIELDS="cefrlevel"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_flwplacement_profile" COMMENT="Latest FLW placement learning-map profile per learner and FLW course">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="coursekey" TYPE="char" LENGTH="80" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="latestresultid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="overallcefr" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="recommendedstartunit" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="nextcheckpointunit" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="placementconfidence" TYPE="number" LENGTH="10" DECIMALS="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="placementstatus" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="skilllevelsjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="kpmasteryjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="supportflagsjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="speakingprofilejson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="learningpathjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="profilejson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="placementhistoryjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="user-coursekey" UNIQUE="true" FIELDS="userid, coursekey"/>
        <INDEX NAME="latestresultid" UNIQUE="false" FIELDS="latestresultid"/>
        <INDEX NAME="overallcefr" UNIQUE="false" FIELDS="overallcefr"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
