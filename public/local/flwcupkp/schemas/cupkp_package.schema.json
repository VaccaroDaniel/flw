{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flw.local/schemas/cupkp_package.schema.json",
  "title": "FLW C-UP-KP Package",
  "type": "object",
  "required": [
    "cupkp_schema_version",
    "frameworks",
    "competencies",
    "use_points",
    "knowledge_points"
  ],
  "properties": {
    "cupkp_schema_version": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "unit_code": {
      "type": "string"
    },
    "cefr_level": {
      "type": "string",
      "pattern": "^(PRE-A1|A1|A2|B1|B2|C1|C2)$"
    },
    "flw_stage": {
      "type": "string"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/framework"
      }
    },
    "competencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/competency"
      }
    },
    "use_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/use_point"
      }
    },
    "knowledge_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge_point"
      }
    },
    "competency_up_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/competency_up_mapping"
      }
    },
    "up_kp_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/up_kp_mapping"
      }
    },
    "kp_prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kp_prerequisite"
      }
    },
    "learning_objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/learning_object"
      }
    },
    "lesson_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson_mapping"
      }
    },
    "activity_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity_mapping"
      }
    },
    "project_competency_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project_competency_mapping"
      }
    },
    "assessment_rules": {
      "type": "array"
    },
    "project_evidence": {
      "type": "array"
    }
  },
  "$defs": {
    "framework": {
      "type": "object",
      "required": ["externalid", "name"],
      "properties": {
        "externalid": {"type": "string"},
        "name": {"type": "string"},
        "course_code": {"type": "string"},
        "language": {"type": "string"},
        "cefr_range": {
          "type": "string",
          "pattern": "^(PRE-A1|A1|A2|B1|B2|C1|C2)(-(PRE-A1|A1|A2|B1|B2|C1|C2))?$"
        },
        "version": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "review", "approved", "published", "validated", "active", "reference", "pilot", "inactive", "archived", "deprecated", "retired", "test"]},
        "description": {"type": "string"}
      }
    },
    "competency": {
      "type": "object",
      "required": ["externalid", "title"],
      "properties": {
        "externalid": {"type": "string"},
        "title": {"type": "string"},
        "can_do": {"type": "string"},
        "description": {"type": "string"},
        "cefr": {
          "type": "string",
          "pattern": "^(PRE-A1|A1|A2|B1|B2|C1|C2)$"
        },
        "stage": {"type": "string"},
        "domain": {"type": "string"},
        "scope": {"type": "string"},
        "evidence_rule": {"type": "object"},
        "status": {"type": "string", "enum": ["draft", "review", "approved", "published", "validated", "active", "reference", "pilot", "inactive", "archived", "deprecated", "retired", "test"]},
        "version": {"type": "string"}
      }
    },
    "use_point": {
      "type": "object",
      "required": ["externalid", "title"],
      "properties": {
        "externalid": {"type": "string"},
        "title": {"type": "string"},
        "action_statement": {"type": "string"},
        "intention": {"type": "string"},
        "context": {"type": "string"},
        "observable_action": {"type": "string"},
        "conditions": {"type": "string"},
        "success_criteria": {"type": "string"},
        "cefr": {
          "type": "string",
          "pattern": "^(PRE-A1|A1|A2|B1|B2|C1|C2)$"
        },
        "language_mode": {"type": "string"},
        "interaction_type": {"type": "string"},
        "evidence_requirements": {"type": "array"},
        "status": {"type": "string", "enum": ["draft", "review", "approved", "published", "validated", "active", "reference", "pilot", "inactive", "archived", "deprecated", "retired", "test"]},
        "version": {"type": "string"}
      }
    },
    "knowledge_point": {
      "type": "object",
      "required": ["externalid", "title", "domain"],
      "properties": {
        "externalid": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "language": {"type": "string"},
        "cefr": {
          "type": "string",
          "pattern": "^(PRE-A1|A1|A2|B1|B2|C1|C2)$"
        },
        "domain": {
          "type": "string",
          "enum": ["LEX", "GRAM", "FUNC", "PRON", "ORTH", "SCRIPT", "LISTEN", "SPEAK", "READ", "WRITE", "DISC", "STRAT", "PRAG", "CULT"]
        },
        "form": {"type": "string"},
        "meaning_function": {"type": "string"},
        "usage_constraints": {"type": "string"},
        "difficulty": {"type": "number"},
        "estimated_learning_load": {"type": "number"},
        "status": {"type": "string", "enum": ["draft", "review", "approved", "published", "validated", "active", "reference", "pilot", "inactive", "archived", "deprecated", "retired", "test"]},
        "version": {"type": "string"}
      }
    },
    "competency_up_mapping": {
      "type": "object",
      "required": ["competency_externalid", "up_externalid"],
      "properties": {
        "competency_externalid": {"type": "string"},
        "up_externalid": {"type": "string"},
        "role": {"type": "string", "enum": ["required", "supporting", "support", "optional", "extension", "remediation", "enrichment", "assessment", "evidence"]},
        "weight": {"type": "number"},
        "sequence": {"type": "integer"},
        "minimum_up_mastery": {"type": "number"},
        "notes": {"type": "string"}
      }
    },
    "up_kp_mapping": {
      "type": "object",
      "required": ["up_externalid", "kp_externalid"],
      "properties": {
        "up_externalid": {"type": "string"},
        "kp_externalid": {"type": "string"},
        "role": {"type": "string", "enum": ["required", "supporting", "support", "optional", "extension", "remediation", "enrichment", "assessment", "evidence"]},
        "weight": {"type": "number"},
        "minimum_kp_readiness": {"type": "number"},
        "sequence": {"type": "integer"},
        "notes": {"type": "string"}
      }
    },
    "kp_prerequisite": {
      "type": "object",
      "required": ["kp_externalid", "prereq_kp_externalid"],
      "properties": {
        "kp_externalid": {"type": "string"},
        "prereq_kp_externalid": {"type": "string"},
        "relationship_type": {"type": "string", "enum": ["prerequisite", "requires", "supports", "extends", "review_of", "alternative_to", "replaced_by", "meaning_support", "production_support", "genre_model", "language_resource", "discourse_support", "genre_support", "SUPPORTS", "REQUIRES", "EXTENDS", "ALTERNATIVE_TO", "REVIEW_OF", "REPLACED_BY"]},
        "strength": {"type": "number"},
        "requirement": {"type": "string", "enum": ["mandatory", "recommended", "optional"]},
        "notes": {"type": "string"}
      }
    },
    "learning_object": {
      "type": "object",
      "required": ["externalid", "title", "object_type"],
      "properties": {
        "externalid": {"type": "string"},
        "title": {"type": "string"},
        "unit_code": {"type": "string"},
        "lesson": {"type": "string"},
        "object_type": {"type": "string"},
        "source_id": {"type": "string"},
        "program1_sourcekey": {"type": "string"},
        "sourcekey": {"type": "string"},
        "unit_id": {"type": "string"},
        "lesson_id": {"type": "string"},
        "component_id": {"type": "string"},
        "activity_id": {"type": "string"},
        "assessment_id": {"type": "string"},
        "question_id": {"type": "string"},
        "purpose": {"type": "string", "enum": ["lesson", "teach", "practice", "assessment", "diagnostic", "placement", "checkpoint", "teacher_observation", "external_assessment", "review", "remediation", "extension", "project", "stt_task", "instruction", "practice_evidence", "performance_evidence", "integrated_performance"]},
        "evidence_strength": {"type": "string", "enum": ["recognition", "guided_performance", "controlled_production", "independent_performance", "direct_performance", "indirect_signal", "diagnostic", "checkpoint", "weak", "medium", "strong"]},
        "difficulty": {"type": "number"},
        "role": {"type": "string", "enum": ["teaches", "trains", "practice", "practices", "assessment", "assesses", "evidence_for", "diagnostic", "placement", "checkpoint", "teacher_observation", "external_assessment", "review", "review_of", "remediation", "extension", "project", "stt_task"]},
        "completion_counts_as_evidence": {"type": ["boolean", "string"]}
      }
    },
    "activity_mapping": {
      "type": "object",
      "required": ["object_externalid", "target_type", "target_externalid"],
      "properties": {
        "object_externalid": {"type": "string"},
        "target_type": {"type": "string", "enum": ["kp", "up", "competency"]},
        "target_externalid": {"type": "string"},
        "role": {"type": "string", "enum": ["teaches", "trains", "practice", "practices", "assessment", "assesses", "evidence_for", "diagnostic", "placement", "checkpoint", "teacher_observation", "external_assessment", "review", "review_of", "remediation", "extension", "project", "stt_task"]},
        "evidence_strength": {"type": "string", "enum": ["recognition", "guided_performance", "controlled_production", "independent_performance", "direct_performance", "indirect_signal", "diagnostic", "checkpoint", "weak", "medium", "strong"]},
        "completion_counts_as_evidence": {"type": ["boolean", "string"]}
      }
    },
    "lesson_mapping": {
      "type": "object",
      "required": ["object_externalid", "title"],
      "properties": {
        "object_externalid": {"type": "string"},
        "externalid": {"type": "string"},
        "title": {"type": "string"},
        "unit_code": {"type": "string"},
        "lesson": {"type": "string"},
        "object_type": {"type": "string"},
        "source_id": {"type": "string"},
        "program1_sourcekey": {"type": "string"},
        "sourcekey": {"type": "string"},
        "unit_id": {"type": "string"},
        "lesson_id": {"type": "string"},
        "component_id": {"type": "string"},
        "activity_id": {"type": "string"},
        "assessment_id": {"type": "string"},
        "question_id": {"type": "string"},
        "purpose": {"type": "string", "enum": ["lesson", "teach", "practice", "assessment", "diagnostic", "placement", "checkpoint", "teacher_observation", "external_assessment", "review", "remediation", "extension", "project", "stt_task", "instruction", "practice_evidence", "performance_evidence", "integrated_performance"]},
        "evidence_strength": {"type": "string", "enum": ["recognition", "guided_performance", "controlled_production", "independent_performance", "direct_performance", "indirect_signal", "diagnostic", "checkpoint", "weak", "medium", "strong"]},
        "difficulty": {"type": "number"},
        "role": {"type": "string", "enum": ["teaches", "trains", "practice", "practices", "assessment", "assesses", "evidence_for", "diagnostic", "placement", "checkpoint", "teacher_observation", "external_assessment", "review", "review_of", "remediation", "extension", "project", "stt_task"]},
        "completion_counts_as_evidence": {"type": ["boolean", "string"]},
        "target_type": {"type": "string", "enum": ["kp", "up", "competency"]},
        "target_externalid": {"type": "string"},
        "kp_externalid": {"type": "string"},
        "kp_externalids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "up_externalid": {"type": "string"},
        "up_externalids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "competency_externalid": {"type": "string"},
        "competency_externalids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "project_competency_mapping": {
      "type": "object",
      "required": ["object_externalid"],
      "properties": {
        "object_externalid": {"type": "string"},
        "externalid": {"type": "string"},
        "competency_externalid": {"type": "string"},
        "competency_externalids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "role": {"type": "string", "enum": ["teaches", "trains", "practice", "practices", "assessment", "assesses", "evidence_for", "diagnostic", "placement", "checkpoint", "teacher_observation", "external_assessment", "review", "review_of", "remediation", "extension", "project", "stt_task"]},
        "evidence_strength": {"type": "string", "enum": ["recognition", "guided_performance", "controlled_production", "independent_performance", "direct_performance", "indirect_signal", "diagnostic", "checkpoint", "weak", "medium", "strong"]},
        "completion_counts_as_evidence": {"type": ["boolean", "string"]},
        "notes": {"type": "string"}
      }
    }
  }
}
