  "use_points": [
    {
      "externalid": "FLW-REW-B2-UP-037-01",
      "title": "Describe a workplace situation",
      "action_statement": "Describe a workplace situation clearly enough for another person to understand the context.",
      "intention": "Set context and identify what is happening.",
      "context": "Workplace meeting, report, customer, or team scenario.",
      "observable_action": "States the situation, people involved, and relevant context.",
      "conditions": "Given a workplace prompt or self-selected situation.",
      "success_criteria": "Listener can identify who is involved, what happened, and why it matters.",
      "cefr": "B2",
      "language_mode": "spoken/written",
      "interaction_type": "monologic or dialogic",
      "evidence_requirements": ["speaking_task", "writing_task"],
      "status": "pilot",
      "version": "1.0"
    },
    {
      "externalid": "FLW-REW-B2-UP-037-02",
      "title": "Explain a workplace problem and its cause",
      "action_statement": "Explain the problem, cause, and consequence without overgeneralizing.",
      "intention": "Clarify the issue and evidence.",
      "context": "Problem-solving discussion or written incident note.",
      "observable_action": "Uses cause-result language and relevant evidence.",
      "conditions": "Given incomplete workplace information or a role-play card.",
      "success_criteria": "Problem and cause are understandable and supported.",
      "cefr": "B2",
      "language_mode": "spoken/written",
      "interaction_type": "explanatory",
      "evidence_requirements": ["quiz", "speaking_task", "project"],
      "status": "pilot",
      "version": "1.0"
    },
    {
      "externalid": "FLW-REW-B2-UP-037-03",
      "title": "Propose an appropriate solution",
      "action_statement": "Propose a realistic solution and compare it with at least one alternative.",
      "intention": "Move from analysis to action.",
      "context": "Team decision, manager update, or customer support response.",
      "observable_action": "Uses modal verbs, comparisons, and practical next steps.",
      "conditions": "Given a problem with two or more possible responses.",
      "success_criteria": "Proposed solution is relevant, polite, and actionable.",
      "cefr": "B2",
      "language_mode": "spoken/written",
      "interaction_type": "problem solving",
      "evidence_requirements": ["speaking_task", "writing_task", "project"],
      "status": "pilot",
      "version": "1.0"
    },
    {
      "externalid": "FLW-REW-B2-UP-037-04",
      "title": "Express and support an opinion",
      "action_statement": "Express a workplace opinion and support it with reasons or evidence.",
      "intention": "State a position while maintaining professional tone.",
      "context": "Meeting, written recommendation, or project reflection.",
      "observable_action": "Gives opinion, reasons, and acknowledgement of alternatives.",
      "conditions": "Given a decision prompt or solution comparison task.",
      "success_criteria": "Opinion is clear, supported, and appropriate for the audience.",
      "cefr": "B2",
      "language_mode": "spoken/written",
      "interaction_type": "argumentation",
      "evidence_requirements": ["speaking_task", "project"],
      "status": "pilot",
      "version": "1.0"
    }
  ],
