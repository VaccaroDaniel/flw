        }
      }
    },
    "/imports/csv/validation": {
      "post": {
        "operationId": "validateCsvImport",
        "x-moodle-wsfunction": "local_flwcupkp_validate_csv_import",
        "summary": "Validate a supported CSV artifact without importing it",
        "requestBody": {
          "$ref": "#/components/requestBodies/CsvImport"
        },
        "responses": {
