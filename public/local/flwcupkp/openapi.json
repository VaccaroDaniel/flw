  },
  "components": {
    "securitySchemes": {
      "moodleToken": {
        "type": "apiKey",
        "in": "query",
        "name": "wstoken"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "FrameworkId": {
        "name": "frameworkid",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        }
      },
      "CourseId": {
        "name": "courseid",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        }
      },
      "Query": {
        "name": "query",
        "in": "query",
        "schema": {
          "type": "string",
          "default": ""
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 100,
          "maximum": 500
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "requestBodies": {
      "JsonEntity": {
        "content": {
          "application/x-www-form-urlencoded": {
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "default": 0
                },
                "datajson": {
                  "type": "string",
                  "description": "JSON object payload for the entity."
                }
              },
              "required": ["datajson"]
            }
          }
        }
      },
      "Mapping": {
        "content": {
          "application/x-www-form-urlencoded": {
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "integer",
                  "default": 0
                },
                "datajson": {
                  "type": "string"
                }
              },
              "required": ["type", "datajson"]
            }
          }
        }
      },
      "Evidence": {
        "content": {
          "application/x-www-form-urlencoded": {
            "schema": {
              "type": "object",
              "required": ["userid", "evidencetype", "targettype", "targetid", "normalizedscore", "evidencestrength"],
              "properties": {
                "userid": {
                  "type": "integer"
                },
                "courseid": {
                  "type": "integer",
                  "default": 0
                },
                "unitcode": {
                  "type": "string"
                },
                "evidencetype": {
                  "type": "string"
                },
                "targettype": {
                  "type": "string",
                  "enum": ["kp", "up", "competency"]
                },
                "targetid": {
                  "type": "integer"
                },
                "rawscore": {
                  "type": "number",
                  "default": 0
                },
                "normalizedscore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "confidence": {
                  "type": "number",
                  "default": 0.5
                },
                "evidencestrength": {
                  "type": "string"
                },
                "provenance": {
                  "type": "string",
                  "default": "manual"
                }
              }
            }
          }
        }
      },
      "ImportPackage": {
        "content": {
          "application/x-www-form-urlencoded": {
            "schema": {
              "type": "object",
              "properties": {
                "json": {
                  "type": "string"
                },
                "sourcefile": {
                  "type": "string"
                }
              },
              "required": ["json"]
            }
          }
        }
      },
      "ValidateImport": {
        "content": {
          "application/x-www-form-urlencoded": {
            "schema": {
              "type": "object",
              "properties": {
                "json": {
                  "type": "string"
                }
              },
              "required": ["json"]
            }
          }
        }
      },
      "CsvImport": {
        "content": {
          "text/csv": {
            "schema": {
              "type": "string"
            }
          },
          "application/x-www-form-urlencoded": {
            "schema": {
              "type": "object",
              "properties": {
                "csv": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": ["activity_mappings", "quiz_kp_mappings"],
                  "default": "activity_mappings"
                },
                "sourcefile": {
                  "type": "string"
                }
              },
              "required": ["csv"]
            }
          }
        }
      }
    },
    "responses": {
      "JsonResponse": {
        "description": "Moodle external-service response. Rich payloads are returned in the json field where noted in API.md.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
          }
        }
      },
      "ImportResponse": {
        "description": "Import result",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "importid": {
                  "type": "integer"
                },
                "status": {
                  "type": "string"
                },
                "entitycount": {
                  "type": "integer"
                },
                "validation": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "EvidenceResponse": {
        "description": "Evidence and recalculated learner state",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "evidenceid": {
                  "type": "integer"
                },
                "state": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
