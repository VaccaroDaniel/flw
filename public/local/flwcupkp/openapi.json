{
  "openapi": "3.1.0",
  "info": {
    "title": "FLW C-UP-KP Moodle External Service",
    "version": "0.1.0-alpha",
    "description": "Logical REST contract for local_flwcupkp. Moodle implements these operations through /webservice/rest/server.php with wsfunction set to the x-moodle-wsfunction value."
  },
  "servers": [
    {
      "url": "/webservice/rest/server.php",
      "description": "Moodle REST web-service endpoint"
    }
  ],
  "security": [
    {
      "moodleToken": []
    }
  ],
  "paths": {
