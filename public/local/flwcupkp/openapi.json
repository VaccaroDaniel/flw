        "operationId": "syncMoodleCompetencies",
        "x-moodle-wsfunction": "local_flwcupkp_sync_moodle_competencies",
        "summary": "Run Moodle competency sync, dry-run by default",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "dryrun": {
                    "type": "boolean",
                    "default": true
