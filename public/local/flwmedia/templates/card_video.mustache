{{!
    @template local_flwmedia/card_video
}}
<article class="flwmedia-card flwmedia-card-watch" data-itemid="{{id}}" data-mode="watch">
    <div class="flwmedia-media">
        <video controls preload="metadata" {{#hasposterurl}}poster="{{posterurl}}"{{/hasposterurl}}>
            {{#hasmediaurl}}<source data-src="{{mediaurl}}">{{/hasmediaurl}}
            {{#hassubtitleurl}}<track src="{{subtitleurl}}" kind="subtitles" srclang="{{lang}}" label="{{#str}}captions, local_flwmedia{{/str}}">{{/hassubtitleurl}}
        </video>
    </div>
    <div class="flwmedia-card-body">
        <h4>{{title}}</h4>
        {{#description}}<p>{{description}}</p>{{/description}}
        {{#hastranscript}}<details><summary>{{#str}}transcript, local_flwmedia{{/str}}</summary><p>{{transcript}}</p></details>{{/hastranscript}}
    </div>
</article>
