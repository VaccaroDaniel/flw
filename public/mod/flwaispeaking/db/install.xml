<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/flwaispeaking/db" VERSION="2026061400" COMMENT="XMLDB file for Moodle mod_flwaispeaking"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="flwaispeaking" COMMENT="FLW AI Speaking activity settings">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="tasktype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="topic"/>
        <FIELD NAME="prompttext" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="targettext" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="referenceaudiourl" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="cefrlevel" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="A1"/>
        <FIELD NAME="kpcodes" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="submissionmode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="transcript"/>
        <FIELD NAME="maxattempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="instantprocess" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="20"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="flwaispeaking_submissions" COMMENT="FLW AI Speaking learner submissions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="flwaispeakingid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="attemptnumber" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="submissiontype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="transcript"/>
        <FIELD NAME="transcript" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="audiofilename" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="audiomimetype" TYPE="char" LENGTH="100" NOTNULL="false"/>
        <FIELD NAME="assessmentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="cefrlevel" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="totalscore" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="rubricjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="weakkpjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="recommendjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="flwaispeakingid" TYPE="foreign" FIELDS="flwaispeakingid" REFTABLE="flwaispeaking" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="activity-user" UNIQUE="false" FIELDS="flwaispeakingid, userid"/>
        <INDEX NAME="activity-user-attempt" UNIQUE="true" FIELDS="flwaispeakingid, userid, attemptnumber"/>
        <INDEX NAME="assessmentid" UNIQUE="false" FIELDS="assessmentid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
